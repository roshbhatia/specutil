<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>specutil</title>
<script>
(function () {
  try {
    var t = localStorage.getItem("specutil-theme");
    if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('chart')"></script>
<style>
/* ================================================================
   SPECUTIL — system.css-inspired theme
   Flat 2px hard shadows, stripe title bars, monochrome with accent.
   Light by default (authentic to classic Mac); dark via override.
   ================================================================ */

:root {
  /* Base palette — strictly monochrome + status accents */
  --bg:        #c0c0c0;      /* Mac OS window chrome / desktop */
  --content:   #ffffff;      /* content area fill */
  --surface-2: #f0f0f0;      /* secondary surface (inset panels) */
  --ink:       #000000;
  --muted:     #666666;
  --line:      #888888;
  --line-dark: #000000;
  --hi:        #ffffff;      /* bevel highlight */
  --shadow-color: #000000;

  /* Selection / accent */
  --accent:    #0055ff;
  --accent-on: #ffffff;

  /* Lifecycle palette — accent color but staying true to Mac feel */
  --lc-proposed-bg:   #e8eeff; --lc-proposed-ink: #002299; --lc-proposed-line: #6688cc;
  --lc-active-bg:     #fff3cc; --lc-active-ink:   #885500; --lc-active-line:   #ccaa33;
  --lc-archived-bg:   #e0f5e0; --lc-archived-ink: #005500; --lc-archived-line: #44aa44;

  --done:   #006600;
  --danger: #cc0022;

  /* DAG */
  --node-bg:     var(--content);
  --node-stroke: var(--ink);
  --edge:        #666666;

  /* Banners */
  --warn-bg:    #fff3cc; --warn-line:   #ccaa33; --warn-ink:   #885500;
  --danger-bg:  #ffe8e8; --danger-line: #cc6666; --danger-ink: #880000;

  /* Type */
  --font-ui:   -apple-system, BlinkMacSystemFont, "Geneva", "Helvetica Neue", Arial, sans-serif;
  --font-mono: "Monaco", "Menlo", ui-monospace, "SFMono-Regular", Consolas, monospace;

  /* System.css signature: flat 2px hard shadow, no blur */
  --hard-shadow: 2px 2px 0 var(--shadow-color);
  --hard-shadow-sm: 1px 1px 0 var(--shadow-color);

  /* Stripe title bar — alternating 1px black / 1px white */
  --stripe: linear-gradient(var(--ink) 50%, transparent 50%);
  --stripe-size: 100% 2px;
}

/* Dark override — "dark system" (inverted Mac tones) */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg:        #1a1a1a;
    --content:   #2a2a2a;
    --surface-2: #222222;
    --ink:       #e8e8e8;
    --muted:     #999999;
    --line:      #555555;
    --line-dark: #888888;
    --hi:        #3d3d3d;
    --shadow-color: #000000;
    --accent:    #4488ff;
    --accent-on: #ffffff;
    --lc-proposed-bg: #0c1a3a; --lc-proposed-ink: #88aaff; --lc-proposed-line: #224488;
    --lc-active-bg:   #1a1200; --lc-active-ink:   #ffcc44; --lc-active-line:   #664400;
    --lc-archived-bg: #001a00; --lc-archived-ink: #44cc44; --lc-archived-line: #226622;
    --done:   #44cc44;
    --danger: #ff4466;
    --node-bg: var(--content); --node-stroke: var(--ink); --edge: #666666;
    --warn-bg:   #1a1200; --warn-line:   #664400; --warn-ink:   #ffcc44;
    --danger-bg: #1a0008; --danger-line: #880033; --danger-ink: #ff6688;
    --stripe: linear-gradient(var(--ink) 50%, transparent 50%);
    --stripe-size: 100% 2px;
  }
}
:root[data-theme="dark"] {
  --bg:        #1a1a1a;
  --content:   #2a2a2a;
  --surface-2: #222222;
  --ink:       #e8e8e8;
  --muted:     #999999;
  --line:      #555555;
  --line-dark: #888888;
  --hi:        #3d3d3d;
  --shadow-color: #000000;
  --accent:    #4488ff;
  --accent-on: #ffffff;
  --lc-proposed-bg: #0c1a3a; --lc-proposed-ink: #88aaff; --lc-proposed-line: #224488;
  --lc-active-bg:   #1a1200; --lc-active-ink:   #ffcc44; --lc-active-line:   #664400;
  --lc-archived-bg: #001a00; --lc-archived-ink: #44cc44; --lc-archived-line: #226622;
  --done:   #44cc44;
  --danger: #ff4466;
  --node-bg: var(--content); --node-stroke: var(--ink); --edge: #666666;
  --warn-bg:   #1a1200; --warn-line:   #664400; --warn-ink:   #ffcc44;
  --danger-bg: #1a0008; --danger-line: #880033; --danger-ink: #ff6688;
  --stripe: linear-gradient(var(--ink) 50%, transparent 50%);
  --stripe-size: 100% 2px;
}

/* ---- Reset ---- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; }
body {
  font-family: var(--font-ui);
  font-size: 13px;
  line-height: 1.5;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
*:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

/* ---- Layout ---- */
.wrap { max-width: 70rem; margin: 0 auto; padding: 0 1rem 4rem; }

/* ---- Typography ---- */
h1 {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 1.2rem;
  letter-spacing: -.01em;
  line-height: 1.2;
  color: var(--ink);
  margin: 0 0 .25rem;
}
h2 {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 1rem;
  line-height: 1.2;
  color: var(--ink);
  margin: 1.25rem 0 .4rem;
}
h3 {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: .875rem;
  margin: 0;
}
h1:focus, h2:focus { outline: none; }
.tnum { font-variant-numeric: tabular-nums; font-family: var(--font-mono); }
code {
  font-family: var(--font-mono);
  font-size: .8em;
  background: var(--surface-2);
  border: 1px solid var(--line);
  padding: .05em .3em;
  color: var(--ink);
}

/* ================================================================
   SYSTEM.CSS CORE PRIMITIVES
   ================================================================ */

/* Window panel — the main visual unit.
   Title bar uses the stripe pattern; content sits below it. */
.win {
  background: var(--content);
  border: 1px solid var(--line-dark);
  box-shadow: var(--hard-shadow);
  border-radius: 0;
  overflow: hidden;
}
.win-title {
  background: var(--stripe);
  background-size: var(--stripe-size);
  background-color: var(--content);
  padding: 3px 6px 3px 24px;    /* 24px left = space for close button area */
  display: flex;
  align-items: center;
  gap: .5rem;
  min-height: 20px;
  position: relative;
  user-select: none;
}
/* Decorative close-button dot (purely cosmetic) */
.win-title::before {
  content: "";
  position: absolute;
  left: 6px;
  top: 50%;
  transform: translateY(-50%);
  width: 12px;
  height: 12px;
  border: 1px solid var(--ink);
  background: var(--content);
  box-shadow: var(--hard-shadow-sm);
}
.win-title-label {
  background: var(--ink);
  color: var(--content);
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .02em;
  padding: 1px 6px;
  white-space: nowrap;
}
.win-title .badge {
  margin-left: auto;
}
.win-body {
  padding: .85rem 1rem;
  background: var(--content);
}

/* ---- Flat button (system.css style) ---- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 600;
  padding: 2px 12px;
  background: var(--content);
  color: var(--ink);
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  cursor: pointer;
  user-select: none;
  text-decoration: none;
  white-space: nowrap;
  transition: none;
}
.btn:hover { background: var(--surface-2); text-decoration: none; }
.btn:active, .btn.on {
  background: var(--ink);
  color: var(--content);
  box-shadow: none;
  transform: translate(2px, 2px);
}

/* ================================================================
   APP BAR — classic Mac menu bar style
   ================================================================ */
.appbar {
  background: var(--content);
  border-bottom: 2px solid var(--ink);
  padding: .5rem 0;
  margin-bottom: 1.25rem;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: .5rem;
}
.appbar .brand {
  font-family: var(--font-ui);
  font-weight: 700;
  font-size: 13px;
  letter-spacing: -.01em;
  color: var(--ink);
  text-decoration: none;
  padding: 2px 8px;
  border-right: 1px solid var(--line);
}
.appbar .brand:hover { background: var(--ink); color: var(--content); text-decoration: none; }
.appbar .right { display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; padding-right: 2px; }
.appbar select {
  font-family: var(--font-ui);
  font-size: 12px;
  padding: 2px 6px;
  border: 1px solid var(--ink);
  background: var(--content);
  color: var(--ink);
  box-shadow: var(--hard-shadow-sm);
  cursor: pointer;
}

/* ---- Nav tabs — look like menu items ---- */
.tabs { display: flex; gap: 0; border-left: 1px solid var(--ink); }
.tabs a {
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 600;
  padding: 2px 10px;
  text-decoration: none;
  color: var(--ink);
  background: var(--content);
  border-right: 1px solid var(--ink);
}
.tabs a:hover { background: var(--surface-2); text-decoration: none; }
.tabs a.on { background: var(--ink); color: var(--content); }

/* ---- Theme toggle ---- */
.toggle {
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  padding: 2px 10px;
  border: 1px solid var(--ink);
  background: var(--content);
  color: var(--ink);
  box-shadow: var(--hard-shadow-sm);
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  transition: none;
}
.toggle:hover { background: var(--surface-2); }
.toggle:active { transform: translate(1px, 1px); box-shadow: none; }

/* ================================================================
   SECTION LABELS
   ================================================================ */
.eyebrow {
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 1.25rem 0 .5rem;
  padding-bottom: .25rem;
  border-bottom: 1px solid var(--line);
}

/* ================================================================
   LIFECYCLE BADGES
   ================================================================ */
.badge {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 1px 6px;
  border: 1px solid transparent;
  vertical-align: middle;
  white-space: nowrap;
}
.badge.proposed { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
.badge.active   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
.badge.archived { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }

/* ================================================================
   PROGRESS METER — classic Mac progress bar
   ================================================================ */
.meter {
  height: 12px;
  background: var(--content);
  border: 1px solid var(--ink);
  overflow: hidden;
  box-shadow: inset 1px 1px 0 var(--line);
}
.meter > span {
  display: block;
  height: 100%;
  /* Classic Mac diagonal stripe fill */
  background: repeating-linear-gradient(
    -45deg,
    var(--ink) 0, var(--ink) 4px,
    transparent 4px, transparent 8px
  );
  transition: width .2s ease;
}
.metric {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted);
  margin: 0;
}

/* ================================================================
   STAT TILES
   ================================================================ */
.tally { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1rem; }
.stat {
  background: var(--content);
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  padding: .65rem .9rem;
  min-width: 6.5rem;
}
.stat b {
  display: block;
  font-family: var(--font-mono);
  font-size: 1.625rem;
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
}
.stat span {
  display: block;
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: .2rem;
}
.stat.rollup { border-left: 3px solid var(--ink); }
.stat.rollup b { font-size: 1.25rem; }

/* ================================================================
   CARD GRID (overview)
   ================================================================ */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
  gap: .85rem;
  margin-top: 1.25rem;
}
.card {
  display: block;
  background: var(--content);
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  padding: 0;
  text-decoration: none;
  color: inherit;
  transition: none;
}
.card:hover {
  box-shadow: 3px 3px 0 var(--ink);
  transform: translate(-1px, -1px);
  text-decoration: none;
}
.card .card-head {
  padding: .65rem .85rem .5rem;
}
.card .row { display: flex; justify-content: space-between; align-items: flex-start; gap: .5rem; }
.card h3 { font-size: .875rem; word-break: break-word; }
.card .why {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: .45rem 0 0;
}
.card .sub {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--muted);
  margin: .3rem 0 0;
}
/* The meter sits flush at the bottom of the card, full-width */
.card .meter { border-left: none; border-right: none; border-bottom: none; border-top: 1px solid var(--line); height: 6px; }
.card.lc-active   { border-top: 3px solid var(--lc-active-line); }
.card.lc-proposed { border-top: 3px solid var(--lc-proposed-line); }
.card.lc-archived { border-top: 3px solid var(--lc-archived-line); }

/* ================================================================
   BOARD VIEW
   ================================================================ */
.board {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: .85rem;
  margin-top: 1.25rem;
  align-items: start;
}
.board .col {
  background: var(--surface-2);
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
}
.board .col > header {
  background: var(--stripe);
  background-size: var(--stripe-size);
  background-color: var(--content);
  padding: 3px 6px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--ink);
}
.board .col > header .badge { margin: 0; }
.board .col > header .ct {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  background: var(--ink);
  color: var(--content);
  padding: 0 4px;
}
.board .col-body { padding: .5rem; }
.board .bcard {
  display: block;
  background: var(--content);
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow-sm);
  padding: .55rem .7rem;
  margin-bottom: .45rem;
  text-decoration: none;
  color: inherit;
  transition: none;
}
.board .bcard:last-child { margin-bottom: 0; }
.board .bcard:hover { box-shadow: 2px 2px 0 var(--ink); transform: translate(-1px, -1px); text-decoration: none; }
.board .bcard h3 { font-size: .8125rem; }
.board .bcard .sub { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin: .25rem 0 0; }
.board .empty-col { font-size: 11px; color: var(--muted); padding: .5rem; }
@media (max-width: 48rem) { .board { grid-template-columns: 1fr; } }

/* ================================================================
   GRAPH VIEW
   ================================================================ */
.dagwrap {
  overflow-x: auto;
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  padding: .75rem;
  background: var(--content);
  margin-top: .85rem;
}
.dagwrap svg text { font-family: var(--font-ui); font-size: 11px; }
.dagwrap .nbox { fill: var(--node-bg); stroke: var(--node-stroke); stroke-width: 1; }
.dagwrap .nlabel { fill: var(--ink); }
.dagwrap .lc-proposed .nbox { fill: var(--lc-proposed-bg); stroke: var(--lc-proposed-line); }
.dagwrap .lc-active   .nbox { fill: var(--lc-active-bg);   stroke: var(--lc-active-line); }
.dagwrap .lc-archived .nbox { fill: var(--lc-archived-bg); stroke: var(--lc-archived-line); }
.dagwrap .node { cursor: pointer; }
.dagwrap .node:focus { outline: none; }
.dagwrap .node:focus .nbox { stroke: var(--accent); stroke-width: 2; }
.dagwrap .edge { stroke: var(--edge); }
.dagwrap .arrow path { fill: var(--edge); }
.dagwrap:hover .node:not(:hover) { opacity: .4; }
.dagwrap.emph .node:not(.lit) { opacity: .3; }
.dagwrap.emph .edge:not(.lit) { opacity: .15; }
.dagwrap .node.lit .nbox { stroke: var(--accent); stroke-width: 2; }

/* ================================================================
   DETAIL DOCUMENT — two-column layout
   ================================================================ */
.doc { margin-top: .5rem; }
.doclayout { display: grid; grid-template-columns: 1fr 16rem; gap: 1.5rem; align-items: start; }
.doclayout .rail { position: sticky; top: .75rem; }
.rail .panel {
  background: var(--content);
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  overflow: hidden;
  margin-bottom: .65rem;
}
.rail .panel-title {
  background: var(--stripe);
  background-size: var(--stripe-size);
  background-color: var(--content);
  padding: 2px 6px 2px 20px;
  border-bottom: 1px solid var(--line);
  position: relative;
}
.rail .panel-title::before {
  content: "";
  position: absolute;
  left: 4px; top: 50%; transform: translateY(-50%);
  width: 10px; height: 10px;
  border: 1px solid var(--ink);
  background: var(--content);
  box-shadow: 1px 1px 0 var(--ink);
}
.rail .panel-title-label {
  background: var(--ink);
  color: var(--content);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  padding: 0 5px;
  display: inline-block;
}
.rail .panel-body { padding: .65rem .75rem; }
.rail .eyebrow { margin-top: .5rem; }
.rail .eyebrow:first-child { margin-top: 0; }
@media (max-width: 52rem) { .doclayout { grid-template-columns: 1fr; } .doclayout .rail { position: static; } }

/* Progress big number */
.progress-big {
  text-align: center;
  padding: .5rem 0 .25rem;
}
.progress-big .num {
  font-family: var(--font-mono);
  font-size: 2.25rem;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}
.progress-big .denom {
  font-family: var(--font-mono);
  font-size: 1rem;
  color: var(--muted);
}
.progress-big .label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  margin-top: .2rem;
}

/* Chartwrap */
.chartwrap { margin: .5rem 0; }

/* ================================================================
   REMAINING TASKS — highlighted block
   ================================================================ */
.remaining {
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  overflow: hidden;
}
.remaining-head {
  background: var(--ink);
  color: var(--content);
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 3px 8px;
}
.remaining-body { background: var(--content); }
.alldone {
  font-family: var(--font-ui);
  font-weight: 700;
  color: var(--done);
  font-size: .9rem;
  padding: .6rem .75rem;
  display: flex;
  align-items: center;
  gap: .35rem;
}

/* ================================================================
   TASK LISTS
   ================================================================ */
ul.tasks { list-style: none; padding: 0; margin: .2rem 0 0; }
ul.tasks li {
  display: flex;
  gap: .4rem;
  align-items: baseline;
  padding: .4rem .5rem;
  border-bottom: 1px solid var(--surface-2);
  font-size: 12px;
  line-height: 1.4;
}
ul.tasks li:last-child { border-bottom: 0; }
ul.tasks li.done .txt { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1px; }

.key {
  flex: 0 0 auto;
  min-width: 2.4rem;
  text-align: center;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  background: var(--surface-2);
  color: var(--muted);
  border: 1px solid var(--line);
  padding: .1rem .3rem;
}
.glyph { flex: 0 0 auto; width: 1rem; text-align: center; font-size: 12px; line-height: 1.3; }
.glyph.done { color: var(--done); }
.glyph.todo { color: var(--line); }
.txt { flex: 1; }

/* Task kind tags */
.kind {
  flex: 0 0 auto;
  font-family: var(--font-ui);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 1px 4px;
  border: 1px solid transparent;
}
.kind.verify  { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
.kind.apply   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
.kind.confirm { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }

/* Phase header */
.phase-h {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  margin-top: 1.25rem;
  padding: .35rem 0;
  border-bottom: 2px solid var(--ink);
}
.phase-h h2 { margin: 0; font-size: .9375rem; }
.phase-h .ct {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  white-space: nowrap;
}

/* ================================================================
   WHY → HOW NARRATIVE BLOCK
   The "problem statement → solution" visual connection.
   ================================================================ */
.narrative {
  margin: 0 0 1.25rem;
}
.narrative-problem, .narrative-solution {
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  overflow: hidden;
}
.narrative-label {
  background: var(--stripe);
  background-size: var(--stripe-size);
  background-color: var(--content);
  padding: 2px 6px 2px 22px;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: .5rem;
  position: relative;
}
.narrative-label::before {
  content: "";
  position: absolute;
  left: 5px; top: 50%; transform: translateY(-50%);
  width: 10px; height: 10px;
  border: 1px solid var(--ink);
  background: var(--content);
  box-shadow: 1px 1px 0 var(--ink);
}
.narrative-label-text {
  background: var(--ink);
  color: var(--content);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 0 5px;
  display: inline-block;
}
.narrative-body {
  padding: .65rem .85rem;
  background: var(--content);
  font-size: 12px;
  line-height: 1.55;
}
.narrative-body p { margin: .35rem 0; }
.narrative-body ul.md { margin: .25rem 0 .5rem; padding-left: 1.2rem; }
.narrative-body ul.md li { margin: .2rem 0; }
/* Arrow connector between problem and solution */
.narrative-arrow {
  text-align: center;
  font-size: 1.1rem;
  color: var(--muted);
  padding: .2rem 0;
  line-height: 1;
  position: relative;
}
.narrative-arrow::before, .narrative-arrow::after {
  content: "";
  position: absolute;
  top: 50%;
  height: 1px;
  width: calc(50% - 1.5rem);
  background: var(--line);
}
.narrative-arrow::before { left: 0; }
.narrative-arrow::after  { right: 0; }

/* ================================================================
   RELATIONSHIP CHIPS
   ================================================================ */
.chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .35rem; }
.chip {
  display: inline-block;
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 600;
  padding: 1px 7px;
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow-sm);
  text-decoration: none;
  color: var(--ink);
  background: var(--content);
}
.chip:hover { background: var(--ink); color: var(--content); text-decoration: none; }
.rail .none { font-size: 11px; color: var(--muted); margin: .3rem 0 0; }

/* ================================================================
   BACK LINK + MISC
   ================================================================ */
.back {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-family: var(--font-ui);
  font-size: 12px;
  font-weight: 600;
  margin-bottom: .85rem;
  color: var(--ink);
  text-decoration: none;
  border: 1px solid var(--ink);
  padding: 2px 10px;
  background: var(--content);
  box-shadow: var(--hard-shadow-sm);
  transition: none;
}
.back:hover { background: var(--ink); color: var(--content); text-decoration: none; }
.back:active { transform: translate(1px, 1px); box-shadow: none; }

.doc p { line-height: 1.6; margin: .4rem 0; font-size: 12px; }
.doc ul.md { margin: .25rem 0 .6rem; padding-left: 1.2rem; }
.doc ul.md li { margin: .2rem 0; line-height: 1.5; font-size: 12px; }

/* ================================================================
   SUGGESTED EDGES PANEL
   ================================================================ */
.suggest-panel {
  margin-top: 1rem;
  border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow);
  overflow: hidden;
}
.suggest-head {
  background: var(--stripe);
  background-size: var(--stripe-size);
  background-color: var(--content);
  padding: 3px 8px 3px 8px;
  border-bottom: 1px solid var(--ink);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .04em;
}
.suggest-body { background: var(--content); padding: .6rem .75rem; overflow-x: auto; }
.suggest-table {
  border-collapse: collapse;
  font-size: 11px;
  width: 100%;
  min-width: 36rem;
}
.suggest-table th {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  text-align: left;
  padding: .3rem .5rem;
  border-bottom: 2px solid var(--ink);
}
.suggest-table td {
  padding: .35rem .5rem;
  border-bottom: 1px solid var(--surface-2);
  vertical-align: middle;
}
.suggest-table tr:last-child td { border-bottom: 0; }

/* ================================================================
   BANNERS
   ================================================================ */
#offline-note {
  background: var(--warn-bg);
  border: 1px solid var(--warn-line);
  box-shadow: var(--hard-shadow-sm);
  color: var(--warn-ink);
  padding: .5rem .75rem;
  font-size: 11px;
  margin-bottom: .85rem;
}
#diag-banner {
  background: var(--danger-bg);
  border: 1px solid var(--danger-line);
  box-shadow: var(--hard-shadow-sm);
  color: var(--danger-ink);
  padding: .5rem .75rem;
  font-size: 11px;
  margin-bottom: .85rem;
}
#diag-banner b { font-weight: 700; }
#diag-banner ul { margin: .3rem 0 0; padding-left: 1.1rem; }

.empty {
  color: var(--muted);
  max-width: 36rem;
  line-height: 1.6;
  font-size: 12px;
  margin-top: .75rem;
}

/* ================================================================
   A11Y
   ================================================================ */
.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; transform: none !important; }
}
</style>
</head>
<body>
<div class="wrap">
  <header class="appbar" id="appbar">
    <a class="brand" href="#/">&#9672; specutil</a>
    <div class="right" id="appbar-right"></div>
  </header>
  <div id="diag-banner" hidden></div>
  <div id="offline-note" hidden>CDN assets failed to load. Task content is still readable below.</div>
  <div id="live" class="sr-only" aria-live="polite"></div>
  <main id="view"></main>
  <noscript><p style="margin-top:2rem;color:var(--muted);font-size:12px">This visualizer requires JavaScript.</p></noscript>
</div>

<template id="dag">{{.DagSVG}}</template>

<script>
const GRAPH = {{.GraphJSON}};
const DETAIL = {{.DetailJSON}};
const DIAG = {{.DiagJSON}};
const SUGGEST = {{.SuggestJSON}};
</script>

<script>
(function () {
  const changes    = (DETAIL && DETAIL.changes) || [];
  const edges      = (GRAPH  && GRAPH.edges)   || [];
  const diags      = DIAG || [];
  const candidates = SUGGEST || [];
  const byName  = new Map(changes.map((c) => [c.name, c]));
  const single  = changes.length === 1;
  const multi   = changes.length > 1;

  const view = document.getElementById("view");
  const live = document.getElementById("live");
  let sel = null;

  /* ---- escaping + minimal markdown ---- */
  const esc = (s) => String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const inline = (s) => s
    .replace(/`([^`]+)`/g, (_, c) => "<code>" + c + "</code>")
    .replace(/\*\*([^*]+)\*\*/g, (_, c) => "<strong>" + c + "</strong>");
  function md(src) {
    const lines = String(src || "").split(/\r?\n/);
    let html = "", inList = false, para = [];
    const flushPara = () => { if (para.length) { html += "<p>" + inline(esc(para.join(" "))) + "</p>"; para = []; } };
    const closeList = () => { if (inList) { html += "</ul>"; inList = false; } };
    for (const raw of lines) {
      const line = raw.replace(/\s+$/, "");
      const item = line.match(/^\s*[-*]\s+(.*)$/);
      if (item) {
        flushPara();
        if (!inList) { html += '<ul class="md">'; inList = true; }
        html += "<li>" + inline(esc(item[1])) + "</li>";
        continue;
      }
      if (line.trim() === "") { flushPara(); closeList(); continue; }
      closeList(); para.push(line.trim());
    }
    flushPara(); closeList();
    return html;
  }

  /* ---- helpers ---- */
  const pctOf      = (c) => (c.total ? Math.round((c.done / c.total) * 100) : 0);
  const dependsOn  = (name) => edges.filter((e) => e.to   === name).map((e) => e.from).sort();
  const blocks     = (name) => edges.filter((e) => e.from === name).map((e) => e.to).sort();
  const chipLink   = (n) => '<a class="chip" href="#/c/' + encodeURIComponent(n) + '">' + esc(n) + "</a>";
  const LIFECYCLES = ["proposed", "active", "archived"];

  function destroyChart() { if (window.__chart) { window.__chart.destroy(); window.__chart = null; } }

  function afterRender() {
    const t = document.getElementById("view-title");
    if (t) { t.focus(); if (live) live.textContent = t.textContent + " view"; }
    syncTabs();
  }

  /* ---- phase chart ---- */
  function cssVar(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim() || "#888"; }
  function phaseChartLabel(c) {
    return "Progress by phase. " + (c.phases || []).map((p) => {
      const d = p.items.filter((i) => i.done).length;
      return "Phase " + p.number + ": " + d + " of " + p.items.length;
    }).join(". ");
  }
  function initPhaseChart(c) {
    if (typeof Chart === "undefined") return;
    const ctx = document.getElementById("phasechart");
    if (!ctx) return;
    const labels = c.phases.map((p) => "P" + p.number);
    const done   = c.phases.map((p) => p.items.filter((i) => i.done).length);
    const rem    = c.phases.map((p) => p.items.length - p.items.filter((i) => i.done).length);
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ink = cssVar("--ink"), muted = cssVar("--muted"), surface = cssVar("--surface-2");
    window.__chartChange = c.name;
    window.__chart = new Chart(ctx, {
      type: "bar",
      data: {
        labels,
        datasets: [
          { label: "Done",      data: done, backgroundColor: ink,     borderWidth: 0, borderRadius: 0 },
          { label: "Remaining", data: rem,  backgroundColor: surface, borderWidth: 1, borderColor: muted, borderRadius: 0 },
        ],
      },
      options: {
        indexAxis: "y", responsive: true, maintainAspectRatio: false,
        animation: reduce ? false : { duration: 200 },
        scales: {
          x: { stacked: true, beginAtZero: true, ticks: { precision: 0, font: { family: "monospace", size: 10 }, color: muted }, grid: { display: false } },
          y: { stacked: true, ticks: { font: { family: "monospace", size: 10 }, color: ink }, grid: { display: false } },
        },
        plugins: { legend: { display: false } },
      },
    });
  }

  /* ---- DAG mount ---- */
  function hasDag() {
    const t = document.getElementById("dag");
    return t && t.content && t.content.childElementCount > 0;
  }
  function mountDag(slot) {
    const t = document.getElementById("dag");
    slot.appendChild(t.content.cloneNode(true));
    const svg = slot.querySelector("svg");
    if (!svg) return;
    const nodes = Array.from(svg.querySelectorAll(".node"));
    const lines = Array.from(svg.querySelectorAll(".edge"));
    nodes.forEach((n) => {
      n.addEventListener("mouseenter", () => {
        const id = n.getAttribute("data-node");
        const nbrs = new Set([id]);
        lines.forEach((l) => {
          const f = l.getAttribute("data-from"), tt = l.getAttribute("data-to");
          if (f === id || tt === id) { l.classList.add("lit"); nbrs.add(f); nbrs.add(tt); }
        });
        nodes.forEach((m) => { if (nbrs.has(m.getAttribute("data-node"))) m.classList.add("lit"); });
        slot.classList.add("emph");
      });
      n.addEventListener("mouseleave", () => {
        slot.classList.remove("emph");
        nodes.forEach((m) => m.classList.remove("lit"));
        lines.forEach((l) => l.classList.remove("lit"));
      });
    });
  }

  /* ---- window panel helper ---- */
  function winPanel(title, badge, body) {
    return '<div class="win">' +
      '<div class="win-title"><span class="win-title-label">' + esc(title) + "</span>" +
      (badge ? " " + badge : "") + "</div>" +
      '<div class="win-body">' + body + "</div></div>";
  }

  /* ---- views ---- */
  function renderEmpty() {
    view.innerHTML = winPanel("specutil — no workstreams", "",
      '<h1 tabindex="-1" id="view-title" style="font-size:1rem;margin-bottom:.5rem">No workstreams found</h1>' +
      '<p class="empty">Create changes under <code>openspec/changes/&lt;name&gt;/</code>, ' +
      "seed dependencies with <code>specutil graph --suggest</code>, then run <code>specutil serve</code>.</p>"
    );
    afterRender();
  }

  function stat(n, label, cls) {
    return '<div class="stat' + (cls ? " " + cls : "") + '"><b class="tnum">' + (n || 0) +
      "</b><span>" + label + "</span></div>";
  }

  function renderOverview() {
    const tally = { active: 0, proposed: 0, archived: 0 };
    let done = 0, total = 0;
    changes.forEach((c) => { tally[c.lifecycle] = (tally[c.lifecycle] || 0) + 1; done += c.done; total += c.total; });
    const pct = total ? Math.round((done / total) * 100) : 0;

    const edgeSet    = new Set(edges.map((e) => e.from + "\x00" + e.to));
    const novelCands = candidates.filter((c) => !edgeSet.has(c.from + "\x00" + c.to));

    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.75rem">Workstreams</h1>';
    h += '<div class="tally">' +
      stat(tally.active,   "active")   +
      stat(tally.proposed, "proposed") +
      stat(tally.archived, "archived") +
      '<div class="stat rollup"><b class="tnum">' + done + '<span style="font-size:.6em;font-weight:400;color:var(--muted)">/' + total + '</span></b><span>tasks &middot; ' + pct + '%</span></div>' +
      (novelCands.length ? '<a class="stat" href="#/graph" style="text-decoration:none;border-style:dashed;cursor:pointer">' +
        '<b class="tnum">' + novelCands.length + '</b><span>suggested deps</span></a>' : "") +
      "</div>";

    h += '<div class="grid">';
    changes.forEach((c) => {
      const pct = pctOf(c);
      h += '<a class="card lc-' + esc(c.lifecycle) + '" href="#/c/' + encodeURIComponent(c.name) + '">' +
        '<div class="card-head">' +
        '<div class="row"><h3>' + esc(c.name) + '</h3><span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span></div>" +
        '<p class="metric tnum" style="margin:.35rem 0 .2rem">' + c.done + " / " + c.total + " tasks &middot; " + pct + "%</p>" +
        '<p class="sub">' + ((c.phases || []).length) + " phases</p>" +
        (c.why ? '<p class="why">' + esc(c.why) + "</p>" : "") +
        "</div>" +
        '<div class="meter"><span style="width:' + pct + '%"></span></div>' +
        "</a>";
    });
    h += "</div>";

    if (!hasDag() && edges.length === 0 && !novelCands.length) {
      h += '<p style="margin-top:1.5rem;font-size:11px;color:var(--muted)">No cross-change dependencies defined ' +
        "and no shared capabilities found to infer from. Add edges to <code>openspec/specutil.yaml</code>.</p>";
    }

    view.innerHTML = h;
    if (sel) sel.value = "__overview__";
    afterRender();
  }

  function renderBoard() {
    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.75rem">Board</h1>';
    h += '<div class="board">';
    LIFECYCLES.forEach((lc) => {
      const col = changes.filter((c) => c.lifecycle === lc);
      h += '<section class="col">' +
        '<header><span class="badge ' + lc + '">' + lc + '</span><span class="ct">' + col.length + "</span></header>" +
        '<div class="col-body">';
      if (!col.length) {
        h += '<p class="empty-col">None</p>';
      } else {
        col.forEach((c) => {
          const pct = pctOf(c);
          h += '<a class="bcard" href="#/c/' + encodeURIComponent(c.name) + '">' +
            "<h3>" + esc(c.name) + "</h3>" +
            '<div class="meter" style="margin:.3rem 0 .2rem"><span style="width:' + pct + '%"></span></div>' +
            '<p class="sub tnum">' + c.done + "/" + c.total + " &middot; " + pct + "% &middot; " + ((c.phases || []).length) + " ph</p>" +
            "</a>";
        });
      }
      h += "</div></section>";
    });
    h += "</div>";
    view.innerHTML = h;
    if (sel) sel.value = "__board__";
    afterRender();
  }

  function renderGraph() {
    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.75rem">Dependency Graph</h1>';
    if (hasDag()) {
      h += '<p style="font-size:11px;color:var(--muted);margin-bottom:.5rem">Arrows point from prerequisite to dependent. Hover a node to highlight neighbors; click to open.</p>';
      h += '<div class="dagwrap"></div>';
    } else {
      h += '<p class="empty">No confirmed cross-change dependencies in <code>openspec/specutil.yaml</code>.</p>';
    }

    /* ---- Suggested edges (always shown when present) ---- */
    if (candidates.length) {
      /* Filter out candidates already in the manifest */
      const edgeSet = new Set(edges.map((e) => e.from + "\x00" + e.to));
      const novel = candidates.filter((c) => !edgeSet.has(c.from + "\x00" + c.to));
      if (novel.length) {
        h += '<div class="suggest-panel">';
        h += '<div class="suggest-head">&#9670; Suggested edges (' + novel.length + ') &mdash; inferred from shared capabilities</div>';
        h += '<div class="suggest-body"><table class="suggest-table">' +
          '<thead><tr><th>From (prerequisite)</th><th>To (dependent)</th><th>Shared capability</th><th>Add to specutil.yaml</th></tr></thead><tbody>';
        novel.forEach((c) => {
          const snippet = esc("- from: " + c.from + "\n  to: " + c.to);
          h += '<tr>' +
            '<td><a class="chip" href="#/c/' + encodeURIComponent(c.from) + '">' + esc(c.from) + "</a></td>" +
            '<td><a class="chip" href="#/c/' + encodeURIComponent(c.to)   + '">' + esc(c.to)   + "</a></td>" +
            '<td><code>' + esc(c.capability) + "</code></td>" +
            '<td><code style="font-size:10px;white-space:pre">' + snippet + "</code></td>" +
            "</tr>";
        });
        h += "</tbody></table></div></div>";
      }
    }

    view.innerHTML = h;
    if (hasDag()) { const slot = view.querySelector(".dagwrap"); if (slot) mountDag(slot); }
    if (sel) sel.value = "__graph__";
    afterRender();
  }

  function kindTag(it) {
    const k = it.kind;
    if (!k || k === "task") return "";
    return '<span class="kind ' + esc(k) + '" title="' + esc(k) + ' step">' + esc(k) + "</span>";
  }

  function renderDetail(name) {
    const c = byName.get(name);
    if (!c) { renderOverview(); return; }
    const pct       = pctOf(c);
    const remaining = [];
    (c.phases || []).forEach((p) => (p.items || []).forEach((it) => { if (!it.done) remaining.push(it); }));
    const deps = dependsOn(name), blks = blocks(name);

    let h = "";
    if (!single) h += '<a class="back" href="#/">&#9664; All workstreams</a>';
    h += '<div class="doc">';

    /* ---- Header with title + badge ---- */
    h += '<div style="display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-bottom:.85rem">';
    h += '<h1 tabindex="-1" id="view-title">' + esc(c.name) + "</h1>";
    h += '<span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span>";
    h += "</div>";

    h += '<div class="doclayout"><div class="main">';

    /* ---- WHY → HOW narrative block ---- */
    /* This is the key UX improvement: connect the problem statement (Why)
       to the solution (What Changes) with a clear visual bridge. */
    if (c.why || c.whatChanges) {
      h += '<div class="narrative">';
      if (c.why) {
        h += '<div class="narrative-problem">' +
          '<div class="narrative-label"><span class="narrative-label-text">Problem</span></div>' +
          '<div class="narrative-body">' + md(c.why) + '</div>' +
          '</div>';
      }
      if (c.why && c.whatChanges) {
        h += '<div class="narrative-arrow" aria-hidden="true">&#8595; solves it by</div>';
      }
      if (c.whatChanges) {
        h += '<div class="narrative-solution">' +
          '<div class="narrative-label"><span class="narrative-label-text">Solution</span></div>' +
          '<div class="narrative-body">' + md(c.whatChanges) + '</div>' +
          '</div>';
      }
      h += '</div>';
    }

    /* ---- Remaining tasks ---- */
    h += '<div class="remaining">';
    h += '<div class="remaining-head">Remaining &mdash; ' + remaining.length + " of " + c.total + " outstanding</div>";
    if (remaining.length === 0) {
      h += '<p class="alldone">&#10003; All ' + c.total + " tasks complete</p>";
    } else {
      h += '<div class="remaining-body"><ul class="tasks">';
      remaining.forEach((it) => {
        h += '<li>' +
          '<span class="glyph todo" aria-hidden="true">&#9744;</span>' +
          '<span class="key">' + esc(it.key) + "</span>" +
          kindTag(it) +
          '<span class="txt">' + esc(it.text) + "</span></li>";
      });
      h += "</ul></div>";
    }
    h += "</div>"; /* remaining */

    /* ---- Tasks by phase ---- */
    h += '<p class="eyebrow" style="margin-top:1.25rem">All tasks by phase</p>';
    (c.phases || []).forEach((p) => {
      const items = p.items || [];
      const d     = items.filter((i) => i.done).length;
      const phPct = items.length ? Math.round((d / items.length) * 100) : 0;
      h += '<div class="phase-h">' +
        '<h2>' + esc(p.number) + ". " + esc(p.name) + "</h2>" +
        '<span class="ct tnum">' + d + "/" + items.length + " &middot; " + phPct + "%</span>" +
        "</div>";
      h += '<div class="meter" style="margin:.2rem 0 .4rem"><span style="width:' + phPct + '%"></span></div>';
      h += '<ul class="tasks">';
      items.forEach((it) => {
        h += '<li class="' + (it.done ? "done" : "") + '">' +
          '<span class="glyph ' + (it.done ? "done" : "todo") + '" aria-hidden="true">' +
          (it.done ? "&#10003;" : "&#9744;") + "</span>" +
          '<span class="sr-only">' + (it.done ? "Done: " : "To do: ") + "</span>" +
          '<span class="key">' + esc(it.key) + "</span>" +
          kindTag(it) +
          '<span class="txt">' + esc(it.text) + "</span></li>";
      });
      h += "</ul>";
    });
    h += "</div>"; /* .main */

    /* ---- Rail ---- */
    h += '<aside class="rail">';

    /* Progress panel */
    h += '<div class="panel">' +
      '<div class="panel-title"><span class="panel-title-label">Progress</span></div>' +
      '<div class="panel-body">' +
      '<div class="progress-big">' +
      '<span class="num">' + pct + '</span>' +
      '<span style="font-family:var(--font-mono);font-size:.9rem;color:var(--muted)">%</span>' +
      '<p class="label">' + c.done + " / " + c.total + " tasks</p>" +
      "</div>" +
      '<div class="meter" role="img" aria-label="' + pct + ' percent complete"><span style="width:' + pct + '%"></span></div>';

    if ((c.phases || []).length) {
      h += '<div class="chartwrap" style="height:' + (c.phases.length * 26 + 14) + 'px">' +
        '<canvas id="phasechart" role="img" aria-label="' + esc(phaseChartLabel(c)) + '"></canvas></div>';
      h += '<ul class="sr-only">' + c.phases.map((p) => {
        const d = p.items.filter((i) => i.done).length;
        return "<li>Phase " + esc(p.number) + " " + esc(p.name) + ": " + d + " of " + p.items.length + " done</li>";
      }).join("") + "</ul>";
    }
    h += "</div></div>"; /* panel-body, panel */

    /* Relationships panel */
    h += '<div class="panel">' +
      '<div class="panel-title"><span class="panel-title-label">Relationships</span></div>' +
      '<div class="panel-body">';
    h += '<p class="eyebrow">Depends on</p>';
    h += deps.length ? '<div class="chips">' + deps.map(chipLink).join("") + "</div>" : '<p class="none">Nothing &mdash; ready to start.</p>';
    h += '<p class="eyebrow">Blocks</p>';
    h += blks.length ? '<div class="chips">' + blks.map(chipLink).join("") + "</div>" : '<p class="none">Nothing downstream.</p>';
    h += "</div></div>"; /* panel-body, panel */

    h += "</aside>";
    h += "</div>"; /* .doclayout */
    h += "</div>"; /* .doc */

    view.innerHTML = h;
    if (sel) sel.value = single ? "__overview__" : name;
    afterRender();
    if ((c.phases || []).length) initPhaseChart(c);
  }

  /* ---- routing ---- */
  let currentRoute = "/";
  function route() {
    destroyChart();
    if (changes.length === 0) { currentRoute = "/"; renderEmpty(); return; }
    if (single) { currentRoute = "/c"; renderDetail(changes[0].name); return; }
    const h = location.hash.replace(/^#/, "");
    const m = h.match(/^\/c\/(.+)$/);
    if (m) {
      const name = decodeURIComponent(m[1]);
      if (byName.has(name)) { currentRoute = "/c/" + name; renderDetail(name); return; }
    }
    if (h === "/board") { currentRoute = "/board"; renderBoard(); return; }
    if (h === "/graph") { currentRoute = "/graph"; renderGraph(); return; }
    currentRoute = "/"; renderOverview();
  }

  /* ---- app bar ---- */
  const right = document.getElementById("appbar-right");

  function syncTabs() {
    document.querySelectorAll(".tabs a").forEach((a) => {
      const r  = a.getAttribute("data-route");
      const on = (r === "/" && currentRoute === "/") ||
                 (r === "/board" && currentRoute === "/board") ||
                 (r === "/graph" && currentRoute === "/graph");
      a.classList.toggle("on", !!on);
    });
  }

  if (multi) {
    const tabs = document.createElement("nav");
    tabs.className = "tabs";
    [["/", "Overview"], ["/board", "Board"], ["/graph", "Graph"]].forEach(([r, label]) => {
      const a = document.createElement("a");
      a.href = "#" + r; a.textContent = label; a.setAttribute("data-route", r);
      tabs.appendChild(a);
    });
    right.appendChild(tabs);
  }

  /* Theme toggle */
  const toggle = document.createElement("button");
  toggle.className = "toggle"; toggle.type = "button";
  toggle.setAttribute("aria-label", "Toggle color theme");
  function currentMode() {
    try { return localStorage.getItem("specutil-theme") || "auto"; } catch (e) { return "auto"; }
  }
  function applyMode(mode) {
    if (mode === "auto") document.documentElement.removeAttribute("data-theme");
    else document.documentElement.setAttribute("data-theme", mode);
    try { localStorage.setItem("specutil-theme", mode); } catch (e) {}
    const glyph = mode === "light" ? "&#9728;" : mode === "dark" ? "&#9789;" : "&#9681;";
    const label = mode === "auto" ? "Auto" : mode.charAt(0).toUpperCase() + mode.slice(1);
    toggle.innerHTML = glyph + " " + label;
    if (window.__chart && window.__chartChange) {
      const c = byName.get(window.__chartChange); destroyChart(); if (c) initPhaseChart(c);
    }
  }
  toggle.addEventListener("click", () => {
    const order = ["auto", "light", "dark"];
    applyMode(order[(order.indexOf(currentMode()) + 1) % order.length]);
  });
  applyMode(currentMode());
  right.appendChild(toggle);

  if (window.matchMedia) {
    const mq = window.matchMedia("(prefers-color-scheme: dark)");
    const onSys = () => {
      if (currentMode() === "auto" && window.__chart && window.__chartChange) {
        const c = byName.get(window.__chartChange); destroyChart(); if (c) initPhaseChart(c);
      }
    };
    if (mq.addEventListener) mq.addEventListener("change", onSys);
    else if (mq.addListener) mq.addListener(onSys);
  }

  if (multi) {
    sel = document.createElement("select");
    sel.setAttribute("aria-label", "Jump to a workstream");
    const o0 = document.createElement("option");
    o0.value = "__overview__"; o0.textContent = "Overview";
    sel.appendChild(o0);
    changes.forEach((c) => {
      const o = document.createElement("option"); o.value = c.name; o.textContent = c.name; sel.appendChild(o);
    });
    sel.addEventListener("change", () => {
      const v = sel.value;
      location.hash = v === "__overview__" ? "#/" :
                      v === "__board__"    ? "#/board" :
                      v === "__graph__"    ? "#/graph" :
                                            "#/c/" + encodeURIComponent(v);
    });
    right.appendChild(sel);
  }

  /* ---- diagnostics banner ---- */
  if (diags.length) {
    const b     = document.getElementById("diag-banner");
    const kinds = Array.from(new Set(diags.map((d) => d.kind))).join(", ");
    b.innerHTML = "<b>Manifest problems (" + esc(kinds) + "):</b><ul>" +
      diags.map((d) => "<li>" + esc(d.msg) + "</li>").join("") + "</ul>";
    b.hidden = false;
  }

  if (window.__cdnFail && window.__cdnFail.length) { document.getElementById("offline-note").hidden = false; }

  window.addEventListener("hashchange", route);
  route();
})();
</script>
</body>
</html>
