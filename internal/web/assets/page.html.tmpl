<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>specutil</title>
<!-- Runtime deps load from a pinned, SRI-protected CDN (no vendored/committed
     bundles). The binary still performs zero network I/O — it only writes this
     static file. onerror flags a CDN miss so the page can warn instead of
     silently rendering blank/unstyled when opened offline. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.0.6/css/pico.min.css" integrity="sha384-7P0NVe9LPDbUCAF+fH2R8Egwz1uqNH83Ns/bfJY0fN2XCDBMUI2S9gGzIOIRBKsA" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('pico')">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('chart')"></script>
<style>
  :root {
    --accent: #2563eb;
    --ink: #0f172a;
    --muted: #64748b;
    --line: #e5e7eb;
    --track: #e2e8f0;
  }
  html { font-size: 16px; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink); background: #fff;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 62rem; margin: 0 auto; padding: 1.75rem 1.25rem 4rem; }
  .doc { max-width: 46rem; }
  h1, h2, h3 { letter-spacing: -0.011em; font-weight: 600; line-height: 1.2; }
  h1 { font-size: 2rem; letter-spacing: -0.02em; margin: 0 0 .25rem; }
  h2 { font-size: 1.375rem; margin: 2rem 0 .5rem; }
  h3 { font-size: 1.0625rem; margin: 0; }
  h1:focus, h2:focus { outline: none; }
  .tnum { font-variant-numeric: tabular-nums; }

  .appbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid var(--line); padding-bottom: .85rem; margin-bottom: 1.5rem; }
  .appbar .brand { font-weight: 600; letter-spacing: -0.01em; color: inherit; text-decoration: none; font-size: 1.05rem; }
  .appbar select { font-size: .875rem; padding: .25rem .5rem; border: 1px solid var(--line); border-radius: 8px; margin: 0; width: auto; background: #fff; }

  .eyebrow { font-size: .6875rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 1.75rem 0 .5rem; }

  .badge { display: inline-block; font-size: .6875rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: .125rem .5rem; border-radius: 6px; border: 1px solid transparent; vertical-align: middle; }
  .badge.proposed { background: #f1f5f9; color: #475569; border-color: #e2e8f0; }
  .badge.active   { background: #fef3c7; color: #b45309; border-color: #fde68a; }
  .badge.archived { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }

  .meter { height: 6px; border-radius: 999px; background: var(--track); overflow: hidden; margin: .5rem 0; }
  .meter > span { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
  .metric { font-size: .9rem; color: var(--muted); margin: 0; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
  .card { display: block; border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; text-decoration: none; color: inherit; background: #fff; transition: border-color .12s, box-shadow .12s; }
  .card:hover { border-color: #cbd5e1; box-shadow: 0 1px 2px rgba(16,24,40,.05); }
  .card .row { display: flex; justify-content: space-between; align-items: start; gap: .5rem; }
  .card .why { color: var(--muted); font-size: .875rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: .6rem 0 0; }
  .card .sub { font-size: .8125rem; color: var(--muted); margin: .5rem 0 0; }

  .tally { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  .stat { border: 1px solid var(--line); border-radius: 10px; padding: .65rem 1rem; min-width: 6rem; }
  .stat b { display: block; font-size: 1.5rem; font-weight: 600; }
  .stat span { font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }

  .chartwrap { margin: .5rem 0; }

  .remaining { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 10px; padding: .5rem 1rem; background: #f8fafc; }
  .alldone { color: #15803d; font-weight: 600; }

  ul.tasks { list-style: none; padding: 0; margin: .35rem 0 0; }
  ul.tasks li { display: flex; gap: .625rem; align-items: baseline; padding: .375rem 0; border-bottom: 1px solid #f1f5f9; }
  ul.tasks li:last-child { border-bottom: 0; }
  ul.tasks li.done .txt { color: var(--muted); }
  .key { flex: 0 0 auto; min-width: 2rem; text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; background: #f1f5f9; color: #475569; border-radius: 5px; padding: .0625rem .375rem; }
  .glyph { flex: 0 0 auto; width: 1.1rem; text-align: center; }
  .glyph.done { color: #15803d; }
  .glyph.todo { color: #64748b; }
  .txt { flex: 1; }
  .phase-h { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1.5rem; }
  .phase-h h2 { margin: 0; }
  .phase-h .ct { font-size: .8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
  .chip { display: inline-block; font-size: .8125rem; padding: .125rem .625rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--accent); }
  .chip:hover { border-color: #cbd5e1; }

  .back { display: inline-block; font-size: .875rem; margin-bottom: 1rem; color: var(--accent); text-decoration: none; }
  .back:hover { text-decoration: underline; }

  .doc p { line-height: 1.6; }
  .doc ul.md { margin: .25rem 0 .75rem; padding-left: 1.25rem; }
  .doc ul.md li { margin: .25rem 0; line-height: 1.55; }
  code { background: #f1f5f9; border-radius: 4px; padding: .0625rem .25rem; font-size: .875em; }

  .dagwrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; padding: .5rem; }
  .dagwrap svg text { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }

  #offline-note { background: #fef3c7; border: 1px solid #fde68a; color: #92400e; border-radius: 8px; padding: .625rem .875rem; font-size: .875rem; margin-bottom: 1rem; }
  .empty { color: var(--muted); max-width: 36rem; line-height: 1.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>
<div class="wrap">
  <header class="appbar" id="appbar">
    <a class="brand" href="#/">specutil</a>
  </header>
  <div id="offline-note" hidden>This page loads styling and charts from a CDN and needs network access. Some visuals may be missing offline — the task content below is still readable.</div>
  <div id="live" class="sr-only" aria-live="polite"></div>
  <main id="view"></main>
  <noscript><p>This visualizer renders its content with JavaScript. Enable JavaScript to view the workstreams.</p></noscript>
</div>

<!-- Cross-change dependency DAG, pre-rendered as inline SVG in Go (empty unless
     there are 2+ changes with manifest edges). Cloned into the overview. -->
<template id="dag">{{.DagSVG}}</template>

<script>
// Renderer-independent feeds, inlined as JS literals so the page needs no data
// files. GRAPH is the pure cross-change dependency DAG (change nodes + edges);
// DETAIL carries per-workstream content, each task tagged with its 0-based
// level (phase rank) and key (0a, 0b, 1a, …). json.Marshal escaped <, >, & so
// these literals cannot break out of the <script> block.
const GRAPH = {{.GraphJSON}};
const DETAIL = {{.DetailJSON}};
</script>

<script>
(function () {
  const changes = (DETAIL && DETAIL.changes) || [];
  const edges = (GRAPH && GRAPH.edges) || [];
  const byName = new Map(changes.map((c) => [c.name, c]));
  const single = changes.length === 1;

  const view = document.getElementById("view");
  const live = document.getElementById("live");
  let sel = null;

  // ---- escaping + minimal markdown (flat bullets + inline code only) --------
  const esc = (s) => String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  // Inline spans run on the already-escaped string (esc() leaves ` and * intact),
  // so `code` and **bold** render without ever reopening an XSS hole.
  const inline = (s) => s
    .replace(/`([^`]+)`/g, (_, c) => "<code>" + c + "</code>")
    .replace(/\*\*([^*]+)\*\*/g, (_, c) => "<strong>" + c + "</strong>");
  function md(src) {
    const lines = String(src || "").split(/\r?\n/);
    let html = "", inList = false, para = [];
    const flushPara = () => { if (para.length) { html += "<p>" + inline(esc(para.join(" "))) + "</p>"; para = []; } };
    const closeList = () => { if (inList) { html += "</ul>"; inList = false; } };
    for (const raw of lines) {
      const line = raw.replace(/\s+$/, "");
      const item = line.match(/^\s*[-*]\s+(.*)$/);
      if (item) { flushPara(); if (!inList) { html += '<ul class="md">'; inList = true; } html += "<li>" + inline(esc(item[1])) + "</li>"; continue; }
      if (line.trim() === "") { flushPara(); closeList(); continue; }
      closeList(); para.push(line.trim());
    }
    flushPara(); closeList();
    return html;
  }

  // ---- derived helpers ------------------------------------------------------
  const pctOf = (c) => (c.total ? Math.round((c.done / c.total) * 100) : 0);
  const dependsOn = (name) => edges.filter((e) => e.to === name).map((e) => e.from).sort();
  const blocks = (name) => edges.filter((e) => e.from === name).map((e) => e.to).sort();
  const chipLink = (n) => '<a class="chip" href="#/c/' + encodeURIComponent(n) + '">' + esc(n) + "</a>";

  function destroyChart() { if (window.__chart) { window.__chart.destroy(); window.__chart = null; } }

  function afterRender() {
    const t = document.getElementById("view-title");
    if (t) { t.focus(); if (live) live.textContent = t.textContent + " view"; }
  }

  // ---- per-phase progress chart (the one place Chart.js earns its keep) ------
  function phaseChartLabel(c) {
    return "Progress by phase. " + (c.phases || []).map((p) => {
      const d = p.items.filter((i) => i.done).length;
      return "Phase " + p.number + ", " + d + " of " + p.items.length + " complete";
    }).join(". ");
  }
  function initPhaseChart(c) {
    if (typeof Chart === "undefined") return; // CDN miss / offline — sr-only list still conveys it
    const ctx = document.getElementById("phasechart");
    if (!ctx) return;
    const labels = c.phases.map((p) => "Phase " + p.number);
    const done = c.phases.map((p) => p.items.filter((i) => i.done).length);
    const rem = c.phases.map((p) => p.items.length - p.items.filter((i) => i.done).length);
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.__chart = new Chart(ctx, {
      type: "bar",
      data: { labels, datasets: [
        { label: "Done", data: done, backgroundColor: "#2563eb", borderWidth: 0, borderRadius: 3 },
        { label: "Remaining", data: rem, backgroundColor: "#e2e8f0", borderWidth: 0, borderRadius: 3 },
      ] },
      options: {
        indexAxis: "y", responsive: true, maintainAspectRatio: false,
        animation: reduce ? false : { duration: 300 },
        scales: {
          x: { stacked: true, beginAtZero: true, ticks: { precision: 0, font: { size: 12 }, color: "#64748b" }, grid: { display: false } },
          y: { stacked: true, ticks: { font: { size: 12 }, color: "#334155" }, grid: { display: false } },
        },
        plugins: { legend: { display: false } },
      },
    });
  }

  // ---- views ----------------------------------------------------------------
  function renderEmpty() {
    view.innerHTML =
      '<h1 tabindex="-1" id="view-title">No workstreams</h1>' +
      '<p class="empty">Create changes under <code>openspec/changes/&lt;name&gt;/</code>, ' +
      "define cross-change dependencies in <code>openspec/specutil.yaml</code> " +
      "(or run <code>specutil graph --suggest</code>), then regenerate this page.</p>";
    afterRender();
  }

  function renderDetail(name) {
    const c = byName.get(name);
    if (!c) { renderOverview(); return; }
    const pct = pctOf(c);
    const remaining = [];
    (c.phases || []).forEach((p) => (p.items || []).forEach((it) => { if (!it.done) remaining.push(it); }));

    let h = "";
    if (!single) h += '<a class="back" href="#/">&larr; All workstreams</a>';
    h += '<div class="doc">';
    h += '<h1 tabindex="-1" id="view-title">' + esc(c.name) + "</h1>";
    h += '<p><span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span> " +
         '<span class="metric tnum">' + c.done + " / " + c.total + " &middot; " + pct + "%</span></p>";
    h += '<div class="meter" role="img" aria-label="' + pct + ' percent of tasks complete"><span style="width:' + pct + '%"></span></div>';

    h += '<p class="eyebrow">Remaining</p>';
    if (remaining.length === 0) {
      h += '<p class="alldone">&#10003; All ' + c.total + " tasks complete</p>";
    } else {
      h += '<div class="remaining"><ul class="tasks">';
      remaining.forEach((it) => {
        h += "<li><span class=\"key\">" + esc(it.key) + '</span><span class="txt">' + esc(it.text) + "</span></li>";
      });
      h += "</ul></div>";
    }

    if ((c.phases || []).length) {
      h += '<p class="eyebrow">Progress by phase</p>';
      h += '<div class="chartwrap" style="height:' + (c.phases.length * 34 + 12) + 'px">' +
           '<canvas id="phasechart" role="img" aria-label="' + esc(phaseChartLabel(c)) + '"></canvas></div>';
      h += '<ul class="sr-only">' + c.phases.map((p) => {
        const d = p.items.filter((i) => i.done).length;
        return "<li>Phase " + esc(p.number) + " " + esc(p.name) + ": " + d + " of " + p.items.length + " complete</li>";
      }).join("") + "</ul>";
    }

    if (c.why) { h += '<p class="eyebrow">Why</p>' + md(c.why); }
    if (c.whatChanges) { h += '<p class="eyebrow">What changes</p>' + md(c.whatChanges); }

    const deps = dependsOn(name), blks = blocks(name);
    if (deps.length) { h += '<p class="eyebrow">Depends on</p><div class="chips">' + deps.map(chipLink).join("") + "</div>"; }
    if (blks.length) { h += '<p class="eyebrow">Blocks</p><div class="chips">' + blks.map(chipLink).join("") + "</div>"; }

    h += '<p class="eyebrow">Tasks by phase</p>';
    (c.phases || []).forEach((p) => {
      const items = p.items || [];
      const d = items.filter((i) => i.done).length;
      h += '<div class="phase-h"><h2>' + esc(p.number) + ". " + esc(p.name) + '</h2><span class="ct tnum">' + d + "/" + items.length + "</span></div>";
      h += '<ul class="tasks">';
      items.forEach((it) => {
        h += '<li class="' + (it.done ? "done" : "") + '">' +
          '<span class="glyph ' + (it.done ? "done" : "todo") + '" aria-hidden="true">' + (it.done ? "&#10003;" : "&#9744;") + "</span>" +
          '<span class="sr-only">' + (it.done ? "Completed: " : "To do: ") + "</span>" +
          '<span class="key">' + esc(it.key) + "</span>" +
          '<span class="txt">' + esc(it.text) + "</span></li>";
      });
      h += "</ul>";
    });
    h += "</div>";

    view.innerHTML = h;
    if (sel) sel.value = name;
    afterRender();
    if ((c.phases || []).length) initPhaseChart(c);
  }

  function stat(n, label) { return '<div class="stat"><b class="tnum">' + (n || 0) + "</b><span>" + label + "</span></div>"; }

  function renderOverview() {
    const tally = { active: 0, proposed: 0, archived: 0 };
    changes.forEach((c) => { tally[c.lifecycle] = (tally[c.lifecycle] || 0) + 1; });

    let h = '<h1 tabindex="-1" id="view-title">Workstreams</h1>';
    h += '<div class="tally">' + stat(tally.active, "active") + stat(tally.proposed, "proposed") + stat(tally.archived, "archived") + "</div>";

    const dagTpl = document.getElementById("dag");
    const hasDag = dagTpl && dagTpl.content && dagTpl.content.childElementCount > 0;
    if (hasDag) { h += '<p class="eyebrow">Cross-change dependencies</p><div class="dagwrap"></div>'; }

    h += '<div class="grid">';
    changes.forEach((c) => {
      const pct = pctOf(c);
      h += '<a class="card" href="#/c/' + encodeURIComponent(c.name) + '">' +
        '<div class="row"><h3>' + esc(c.name) + '</h3><span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span></div>" +
        '<p class="metric tnum" style="margin:.6rem 0 0">' + c.done + " / " + c.total + " &middot; " + pct + "%</p>" +
        '<div class="meter"><span style="width:' + pct + '%"></span></div>' +
        '<p class="sub">' + ((c.phases || []).length) + " phases</p>" +
        (c.why ? '<p class="why">' + esc(c.why) + "</p>" : "") +
        "</a>";
    });
    h += "</div>";

    if (!hasDag && edges.length === 0) {
      h += '<p class="sub" style="margin-top:2rem">No cross-change dependencies defined. ' +
        "Seed them with <code>specutil graph --suggest</code> or edit <code>openspec/specutil.yaml</code>.</p>";
    }

    view.innerHTML = h;
    if (hasDag) {
      const slot = view.querySelector(".dagwrap");
      if (slot) slot.appendChild(dagTpl.content.cloneNode(true));
    }
    if (sel) sel.value = "__overview__";
    afterRender();
  }

  // ---- routing (hash is the single source of truth; works on file://) -------
  function route() {
    destroyChart();
    if (changes.length === 0) { renderEmpty(); return; }
    if (single) { renderDetail(changes[0].name); return; }
    const h = location.hash.replace(/^#/, "");
    const m = h.match(/^\/c\/(.+)$/);
    if (m) {
      const name = decodeURIComponent(m[1]);
      if (byName.has(name)) { renderDetail(name); return; }
    }
    renderOverview();
  }

  // ---- header: a jump-to select only when there's more than one change ------
  if (changes.length > 1) {
    sel = document.createElement("select");
    sel.setAttribute("aria-label", "Jump to a workstream");
    const o0 = document.createElement("option");
    o0.value = "__overview__"; o0.textContent = "Overview";
    sel.appendChild(o0);
    changes.forEach((c) => { const o = document.createElement("option"); o.value = c.name; o.textContent = c.name; sel.appendChild(o); });
    sel.addEventListener("change", () => {
      location.hash = sel.value === "__overview__" ? "#/" : "#/c/" + encodeURIComponent(sel.value);
    });
    document.getElementById("appbar").appendChild(sel);
  }

  if (window.__cdnFail && window.__cdnFail.length) { document.getElementById("offline-note").hidden = false; }

  window.addEventListener("hashchange", route);
  route();
})();
</script>
</body>
</html>
