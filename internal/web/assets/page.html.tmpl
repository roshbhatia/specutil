<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>specutil</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('chart')"></script>
<script src="https://cdn.jsdelivr.net/npm/cytoscape@3.30.2/dist/cytoscape.min.js" integrity="sha384-IWROdLKRsN1UuJywMlWl7/blXQ8GEooN2n7dzTxfEPd7ybYIKCUJ2Ol/1Gpf3YV4" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('cytoscape')"></script>
<style>
/* ================================================================
   SPECUTIL — neo-industrial system.css theme
   ================================================================ */

:root {
  color-scheme: light;
  --bg:        #d4d0c6;
  --content:   #fffefa;
  --surface-2: #f4f3ec;
  --surface-3: #eae7dd;
  --ink:       #111111;
  --muted:     #565656;
  --line:      #9d988e;
  --line-dark: #1f1f1f;

  --accent:    #002f86;
  --accent-on: #ffffff;

  --lc-proposed-bg:   #dce6ff; --lc-proposed-ink: #002f86; --lc-proposed-line: #8ca7d9;
  --lc-active-bg:     #fff1c8; --lc-active-ink:   #8a5900; --lc-active-line:   #d0a53b;
  --lc-archived-bg:   #dcf0df; --lc-archived-ink: #116232; --lc-archived-line: #79aa80;

  --done:    #116232;
  --warn-bg: #fff1c8; --warn-line: #d0a53b; --warn-ink: #8a5900;
  --err-bg:  #ffe0d7; --err-line:  #c77564; --err-ink:  #9a1e1e;

  --font-ui:   -apple-system, BlinkMacSystemFont, "Geneva", "Helvetica Neue", Arial, sans-serif;
  --font-mono: "Monaco", "Menlo", ui-monospace, "SFMono-Regular", Consolas, monospace;

  --hard-shadow:    2px 2px 0 #111;
  --hard-shadow-sm: 1px 1px 0 #111;
  --panel-head-bg:  #111111;
  --panel-head-fg:  #fffefa;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; }
body {
  font-family: var(--font-ui); font-size: 13px; line-height: 1.5;
  color: var(--ink);
  background:
    linear-gradient(90deg, rgba(0,0,0,.05) 1px, transparent 1px),
    linear-gradient(rgba(0,0,0,.04) 1px, transparent 1px), var(--bg);
  background-size: 16px 16px;
  -webkit-font-smoothing: antialiased;
}
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
*:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
h1 { font-weight: 700; font-size: 1.1rem; letter-spacing: -.01em; }
h2 { font-weight: 700; font-size: .9375rem; margin: 1.1rem 0 .35rem; }
h3 { font-weight: 700; font-size: .875rem; margin: 0; }
h1:focus, h2:focus { outline: none; }
code {
  font-family: var(--font-mono); font-size: .8em;
  background: var(--surface-2); border: 1px solid var(--line);
  padding: .05em .3em; color: var(--ink);
}
.wrap { max-width: 90rem; margin: 0 auto; padding: 0 .875rem 4rem; }
.tnum { font-variant-numeric: tabular-nums; font-family: var(--font-mono); }

/* ================================================================
   APP BAR
   ================================================================ */
.appbar {
  background: var(--content);
  border-bottom: 2px solid var(--ink);
  padding: .35rem 0;
  margin-bottom: .85rem;
  display: flex; align-items: center; gap: 0;
}
.appbar .brand {
  font-weight: 700; font-size: 13px; color: var(--ink);
  text-decoration: none; padding: 3px 10px 3px 0;
  border-right: 1px solid var(--line); margin-right: .5rem;
}
.appbar .brand:hover { text-decoration: none; }
.tabs { display: flex; }
.tabs a {
  font-size: 12px; font-weight: 600;
  padding: 5px 14px; text-decoration: none;
  color: var(--ink); background: var(--content);
}
.tabs a:hover { background: var(--surface-2); text-decoration: none; }
.tabs a.on { background: var(--ink); color: var(--content); }

/* ================================================================
   BADGES / METERS / STATS
   ================================================================ */
.badge {
  display: inline-block; font-size: 9px; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase;
  padding: 1px 6px; border: 1px solid transparent; white-space: nowrap;
}
.badge.proposed { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
.badge.active   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
.badge.archived { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }

.meter { height: 6px; background: var(--surface-3); border: 1px solid var(--ink); overflow: hidden; }
.meter > span { display: block; height: 100%; background: var(--accent); }
.metric { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }

.tally { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .85rem; }
.stat {
  background: var(--content); border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow); padding: .5rem .85rem; min-width: 5rem;
}
.stat b { display: block; font-family: var(--font-mono); font-size: 1.4rem; font-weight: 700; line-height: 1.1; }
.stat span { display: block; font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: .15rem; }

/* ================================================================
   KANBAN BOARD
   ================================================================ */
.board { display: grid; grid-template-columns: repeat(3, 1fr); gap: .65rem; align-items: start; }
.board .col { background: var(--surface-2); border: 1px solid var(--ink); box-shadow: var(--hard-shadow); }
.board .col-head {
  background: var(--panel-head-bg);
  padding: 3px 7px; display: flex; justify-content: space-between; align-items: center;
  border-bottom: 1px solid var(--ink);
}
.board .col-head .badge { border-color: rgba(255,255,255,.25); }
.board .col-head .ct {
  font-family: var(--font-mono); font-size: 11px; font-weight: 700;
  background: rgba(255,255,255,.15); color: var(--panel-head-fg); padding: 0 4px;
}
.board .col-body { padding: .4rem; }
.board .bcard {
  appearance: none; -webkit-appearance: none;
  display: block; width: 100%; text-align: left; font: inherit; cursor: pointer;
  background: var(--content); border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow-sm);
  padding: .5rem .6rem; margin-bottom: .35rem; transition: none;
}
.board .bcard:last-child { margin-bottom: 0; }
.board .bcard:hover { box-shadow: var(--hard-shadow); transform: translate(-1px, -1px); }
.board .bcard h3 { font-size: .8125rem; line-height: 1.3; }
.board .bcard .sub { font-family: var(--font-mono); font-size: 10px; color: var(--muted); margin-top: .25rem; }
.board .bcard .meter { margin: .3rem 0 0; height: 3px; }
.board .empty-col { font-size: 11px; color: var(--muted); padding: .4rem; }
@media (max-width: 42rem) { .board { grid-template-columns: 1fr; } }

/* ================================================================
   GRAPH VIEW — Cytoscape container + inspector
   ================================================================ */
.graph-shell {
  display: grid; grid-template-columns: minmax(0, 1fr) 17rem;
  gap: .65rem; align-items: stretch;
}
.graph-workbench { min-width: 0; }
#cy-container {
  width: 100%; min-height: 420px;
  border: 1px solid var(--ink); box-shadow: var(--hard-shadow);
  background-color: var(--surface-2);
  background-image:
    linear-gradient(90deg, rgba(0,0,0,.06) 1px, transparent 1px),
    linear-gradient(rgba(0,0,0,.06) 1px, transparent 1px);
  background-size: 24px 24px;
}
.graph-inspector {
  background: var(--content); border: 1px solid var(--ink);
  box-shadow: var(--hard-shadow); overflow: hidden;
}
.graph-inspector-head {
  background: var(--panel-head-bg); color: var(--panel-head-fg);
  border-bottom: 1px solid var(--ink); padding: 4px 8px;
  font-family: var(--font-mono); font-size: 10px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase;
}
.graph-inspector-head span { opacity: .65; font-weight: 400; }
.graph-inspector-body { padding: .65rem .75rem; overflow-y: auto; max-height: 420px; }
.graph-empty { padding: 1.5rem; color: var(--muted); line-height: 1.6; }
.graph-toolbar { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
.graph-hint-text { font-size: 11px; color: var(--muted); }
.graph-legend {
  display: flex; gap: .75rem; flex-wrap: wrap; margin-top: .4rem;
  font-size: 10px; color: var(--muted); align-items: center;
}
.legend-item { display: flex; align-items: center; gap: .3rem; }
.legend-line { display: inline-block; width: 24px; height: 0; vertical-align: middle; }
.legend-line.sequential { border-top: 2px solid #999; }
.legend-line.cross      { border-top: 2px dashed #002f86; }
.legend-line.suggested  { border-top: 2px dotted #bbb; }
@media (max-width: 52rem) { .graph-shell { grid-template-columns: 1fr; } }

/* ================================================================
   SUGGESTED EDGES
   ================================================================ */
.suggest-panel { margin-top: .85rem; border: 1px solid var(--ink); box-shadow: var(--hard-shadow); overflow: hidden; }
.suggest-head {
  background: var(--panel-head-bg); color: var(--panel-head-fg); padding: 3px 8px;
  border-bottom: 1px solid var(--ink); font-family: var(--font-mono);
  font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
}
.suggest-head span { opacity: .65; font-weight: 400; }
.suggest-body { background: var(--content); padding: .6rem .75rem; overflow-x: auto; }
.suggest-table { border-collapse: collapse; font-size: 11px; width: 100%; min-width: 34rem; }
.suggest-table th {
  font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: var(--muted); text-align: left; padding: .3rem .5rem; border-bottom: 2px solid var(--ink);
}
.suggest-table td { padding: .35rem .5rem; border-bottom: 1px solid var(--surface-2); }
.suggest-table tr:last-child td { border-bottom: 0; }

/* ================================================================
   DETAIL — DRILLDOWN
   ================================================================ */
.doc { margin-top: .25rem; }
.doclayout { display: grid; grid-template-columns: 1fr 15rem; gap: 1.25rem; align-items: start; }
.doclayout .rail { position: sticky; top: .75rem; }
.rail .panel { background: var(--content); border: 1px solid var(--ink); box-shadow: var(--hard-shadow); overflow: hidden; margin-bottom: .5rem; }
.rail .panel-title {
  background: var(--panel-head-bg); color: var(--panel-head-fg);
  padding: 3px 8px; border-bottom: 1px solid var(--ink);
}
.rail .panel-title-label {
  color: var(--panel-head-fg); font-size: 10px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase;
}
.rail .panel-body { padding: .6rem .75rem; }
@media (max-width: 52rem) { .doclayout { grid-template-columns: 1fr; } .doclayout .rail { position: static; } }

.progress-big { text-align: center; padding: .45rem 0 .2rem; }
.progress-big .num { font-family: var(--font-mono); font-size: 1.85rem; font-weight: 700; line-height: 1; }
.progress-big .label { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-top: .15rem; }
.chartwrap { margin: .45rem 0; }

/* ================================================================
   NARRATIVE — collapsed by default (progressive disclosure)
   ================================================================ */
.narrative { margin: 0 0 1rem; display: flex; flex-direction: column; gap: .35rem; }
details.narrative-block { border: 1px solid var(--ink); box-shadow: var(--hard-shadow); overflow: hidden; }
summary.narrative-summary {
  background: var(--panel-head-bg); color: var(--panel-head-fg);
  padding: 3px 8px; cursor: pointer; list-style: none; user-select: none;
  display: flex; align-items: center; gap: .4rem; border-bottom: 0;
  font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
}
details.narrative-block[open] summary.narrative-summary { border-bottom: 1px solid var(--ink); }
summary.narrative-summary::-webkit-details-marker { display: none; }
summary.narrative-summary::before { content: "+"; font-family: var(--font-mono); font-weight: 700; }
details.narrative-block[open] summary.narrative-summary::before { content: "−"; }
.narrative-body { padding: .6rem .85rem; background: var(--content); font-size: 12px; line-height: 1.55; }
.narrative-body p { margin: .3rem 0; }
.narrative-body ul.md { margin: .25rem 0 .5rem; padding-left: 1.2rem; }
.narrative-body ul.md li { margin: .2rem 0; }

/* ================================================================
   TASK PIPELINE
   ================================================================ */
.pipeline {
  display: flex; align-items: flex-start; gap: 0;
  margin: .5rem 0 .85rem; overflow-x: auto;
  padding-bottom: .25rem;
}
.pipe-stage { display: flex; flex-direction: column; flex: 1; min-width: 6.5rem; }
.pipe-arrow {
  display: flex; align-items: center; padding: 0 .3rem;
  color: var(--muted); font-size: 10px; flex-shrink: 0; margin-top: 1.3rem;
}
.pipe-phase-head {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  letter-spacing: .07em; text-transform: uppercase;
  color: var(--muted); padding: 0 0 .2rem;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pipe-tasks { display: flex; flex-direction: column; gap: 2px; }
.pipe-task {
  border: 1px solid var(--line); background: var(--content);
  padding: 2px 5px; font-family: var(--font-mono); font-size: 9px; color: var(--ink);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pipe-task.done { background: var(--surface-2); color: var(--muted); text-decoration: line-through; }
.pipe-key { font-weight: 700; margin-right: .25rem; }
.pipe-bar { height: 3px; background: var(--line); margin-top: .3rem; overflow: hidden; }
.pipe-bar > span { display: block; height: 100%; background: var(--accent); }

/* ================================================================
   TASK ROWS — Linear/Jira style
   ================================================================ */
.task-list { border: 1px solid var(--ink); box-shadow: var(--hard-shadow-sm); overflow: hidden; }
.task-row {
  display: grid; grid-template-columns: 22px 36px 1fr auto;
  align-items: center; gap: 0;
  padding: 5px 8px; border-bottom: 1px solid var(--surface-3); font-size: 12px;
}
.task-row:last-child { border-bottom: 0; }
.task-row.done .task-title { text-decoration: line-through; text-decoration-thickness: 1px; color: var(--muted); }
.task-row.done .task-check { color: var(--done); }
.task-check { text-align: center; font-size: 13px; color: var(--line); }
.task-key { font-family: var(--font-mono); font-size: 10px; font-weight: 700; color: var(--muted); padding-right: 6px; }
.task-body { display: flex; align-items: center; gap: .35rem; min-width: 0; }
.task-title { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.task-meta { display: flex; align-items: center; gap: .25rem; flex-shrink: 0; }
.task-ext {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700; padding: 1px 5px;
  background: var(--surface-3); border: 1px solid var(--line); color: var(--muted);
}

/* legacy task list kept for inspector only */
ul.tasks { list-style: none; padding: 0; margin: .2rem 0 0; }
ul.tasks li {
  display: flex; gap: .4rem; align-items: baseline;
  padding: .4rem .5rem; border-bottom: 1px solid var(--surface-2);
  font-size: 12px; line-height: 1.4;
}
ul.tasks li:last-child { border-bottom: 0; }
ul.tasks li.done .txt { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1px; }
.key {
  flex: 0 0 auto; min-width: 2.4rem; text-align: center;
  font-family: var(--font-mono); font-size: 10px; font-weight: 700;
  background: var(--surface-2); color: var(--muted);
  border: 1px solid var(--line); padding: .1rem .3rem;
}
.glyph { flex: 0 0 auto; width: 1rem; text-align: center; font-size: 12px; line-height: 1.3; }
.glyph.done { color: var(--done); }
.glyph.todo { color: var(--line); }
.txt { flex: 1; }
.kind {
  flex: 0 0 auto; font-size: 9px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase;
  padding: 1px 4px; border: 1px solid transparent;
}
.kind.verify  { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
.kind.apply   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
.kind.confirm { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }
.ext-ref {
  flex: 0 0 auto; font-family: var(--font-mono); font-size: 9px; font-weight: 700;
  letter-spacing: .04em; padding: 1px 5px;
  background: var(--surface-3); border: 1px solid var(--line); color: var(--muted);
}
.phase-block { margin-top: .85rem; }
.phase-block > summary { cursor: pointer; list-style: none; }
.phase-block > summary::-webkit-details-marker { display: none; }
.phase-h {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 1rem; padding: .3rem 0; border-bottom: 2px solid var(--ink);
}
.phase-h::before { content: "+"; font-family: var(--font-mono); font-weight: 700; margin-right: .25rem; }
.phase-block[open] .phase-h::before { content: "−"; }
.phase-h h2 { margin: 0; font-size: .875rem; }
.phase-h .ct { font-family: var(--font-mono); font-size: 11px; font-weight: 700; color: var(--muted); }
.phase-block.has-open > summary .phase-h { border-bottom-color: var(--accent); }
.phase-open-badge {
  font-family: var(--font-mono); font-size: 9px; font-weight: 700; padding: 1px 4px;
  background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border: 1px solid var(--lc-proposed-line);
  margin-left: .3rem;
}

/* ================================================================
   EYEBROW / CHIPS / MISC
   ================================================================ */
.eyebrow {
  font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--muted); margin: .85rem 0 .35rem; padding-bottom: .2rem;
  border-bottom: 1px solid var(--line);
}
.eyebrow:first-child { margin-top: 0; }
.chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .35rem; }
.chip {
  display: inline-block; font-size: 11px; font-weight: 600;
  padding: 1px 7px; border: 1px solid var(--ink); box-shadow: var(--hard-shadow-sm);
  text-decoration: none; color: var(--ink); background: var(--content);
}
.chip:hover { background: var(--ink); color: var(--content); text-decoration: none; }
.none { font-size: 11px; color: var(--muted); margin: .25rem 0 0; }

.btn {
  display: inline-flex; align-items: center; gap: .35rem;
  font-size: 12px; font-weight: 600;
  min-height: 26px; padding: 3px 10px;
  background: var(--content); color: var(--ink);
  border: 1px solid var(--ink); box-shadow: var(--hard-shadow);
  cursor: pointer; text-decoration: none; white-space: nowrap; transition: none;
}
.btn:hover { background: var(--surface-2); text-decoration: none; }
.btn:active { background: var(--ink); color: var(--content); box-shadow: none; transform: translate(2px,2px); }

.back {
  display: inline-flex; align-items: center; gap: .3rem;
  font-size: 12px; font-weight: 600; margin-bottom: .65rem;
  color: var(--ink); text-decoration: none;
  border: 1px solid var(--ink); padding: 2px 10px;
  background: var(--content); box-shadow: var(--hard-shadow-sm);
}
.back:hover { background: var(--ink); color: var(--content); text-decoration: none; }
.doc p { line-height: 1.6; margin: .4rem 0; font-size: 12px; }
.doc ul.md { margin: .25rem 0 .6rem; padding-left: 1.2rem; }
.doc ul.md li { margin: .2rem 0; line-height: 1.5; font-size: 12px; }

#offline-note {
  background: var(--warn-bg); border: 1px solid var(--warn-line);
  color: var(--warn-ink); padding: .45rem .75rem; font-size: 11px; margin-bottom: .65rem;
}
#diag-banner {
  background: var(--err-bg); border: 1px solid var(--err-line);
  color: var(--err-ink); padding: .45rem .75rem; font-size: 11px; margin-bottom: .65rem;
}
#diag-banner b { font-weight: 700; }
#diag-banner ul { margin: .25rem 0 0; padding-left: 1.1rem; }
.empty { color: var(--muted); max-width: 36rem; line-height: 1.6; font-size: 12px; }

.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; transform: none !important; }
}
</style>
</head>
<body>
<div class="wrap">
  <header class="appbar">
    <a class="brand" href="#/">&#9672; specutil</a>
    <nav class="tabs" id="nav-tabs"></nav>
  </header>
  <div id="diag-banner" hidden></div>
  <div id="offline-note" hidden>CDN assets failed to load. Task content may be limited.</div>
  <div id="live" class="sr-only" aria-live="polite"></div>
  <main id="view"></main>
  <noscript><p style="margin-top:2rem;color:var(--muted);font-size:12px">This visualizer requires JavaScript.</p></noscript>
</div>

<script>
const GRAPH = {{.GraphJSON}};
const DETAIL = {{.DetailJSON}};
const DIAG = {{.DiagJSON}};
const SUGGEST = {{.SuggestJSON}};
</script>

<script>
(function () {
  const changes    = (DETAIL && DETAIL.changes) || [];
  const graphNodes = (GRAPH  && GRAPH.nodes)   || [];
  const edges      = (GRAPH  && GRAPH.edges)   || [];
  const diags      = DIAG || [];
  const candidates = SUGGEST || [];
  const byName     = new Map(changes.map((c) => [c.name, c]));

  const view = document.getElementById("view");
  const live = document.getElementById("live");
  let currentRoute = "/";
  let cyInstance = null;

  /* ---- minimal markdown ---- */
  const esc = (s) => String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const inline = (s) => s
    .replace(/`([^`]+)`/g,      (_, c) => "<code>" + c + "</code>")
    .replace(/\*\*([^*]+)\*\*/g,(_, c) => "<strong>" + c + "</strong>")
    .replace(/\*([^*]+)\*/g,    (_, c) => "<em>" + c + "</em>");
  function md(src) {
    const lines = String(src || "").split(/\r?\n/);
    let html = "", inList = false, para = [];
    const flush = () => { if (para.length) { html += "<p>" + inline(esc(para.join(" "))) + "</p>"; para = []; } };
    const close = () => { if (inList) { html += "</ul>"; inList = false; } };
    for (const raw of lines) {
      const ln = raw.replace(/\s+$/, "");
      const hm = ln.match(/^#{1,6}\s+(.+)/);
      if (hm) { flush(); close(); html += '<p><strong>' + inline(esc(hm[1])) + '</strong></p>'; continue; }
      const li = ln.match(/^\s*[-*]\s+(.*)$/);
      if (li) { flush(); if (!inList) { html += '<ul class="md">'; inList = true; } html += "<li>" + inline(esc(li[1])) + "</li>"; continue; }
      if (!ln.trim()) { flush(); close(); continue; }
      close(); para.push(ln.trim());
    }
    flush(); close();
    return html;
  }

  /* ---- helpers ---- */
  function progressOf(c) {
    const items = (c.phases || []).flatMap((p) => p.items || []);
    const total = items.length || Number(c.total || 0);
    const done  = items.length ? items.filter((i) => i.done).length : Number(c.done || 0);
    return { done, total, pct: total ? Math.round((done / total) * 100) : 0, hasTasks: total > 0 };
  }
  const progressLabel = (c) => {
    const p = progressOf(c);
    return p.hasTasks ? p.done + "/" + p.total + " tasks · " + p.pct + "%" : "No tasks";
  };
  const dependsOn = (n) => edges.filter((e) => e.to   === n).map((e) => e.from).sort();
  const blocks    = (n) => edges.filter((e) => e.from === n).map((e) => e.to).sort();
  const chipLink  = (n) => byName.has(n)
    ? '<a class="chip" href="#/c/' + encodeURIComponent(n) + '">' + esc(n) + "</a>"
    : '<span class="chip">' + esc(n) + "</span>";

  const LIFECYCLES = ["proposed", "active", "archived"];
  const feedIssues = (() => {
    const gids = new Set(graphNodes.map((n) => n.id));
    const dids = new Set(changes.map((c) => c.name));
    const out = [];
    gids.forEach((id) => { if (!dids.has(id)) out.push({ kind: "feed", msg: "Graph node has no detail entry: " + id }); });
    dids.forEach((id) => { if (gids.size && !gids.has(id)) out.push({ kind: "feed", msg: "Detail entry absent from graph: " + id }); });
    return out;
  })();

  const edgeKey = (e) => e.from + "\x00" + e.to;
  function novelCandidateGroups() {
    const confirmed = new Set(edges.map(edgeKey));
    const groups = new Map();
    candidates.forEach((c) => {
      if (confirmed.has(edgeKey(c))) return;
      const g = groups.get(edgeKey(c)) || { from: c.from, to: c.to, capabilities: [] };
      g.capabilities.push(c.capability);
      groups.set(edgeKey(c), g);
    });
    return Array.from(groups.values()).map((g) => ({ ...g, capabilities: [...new Set(g.capabilities)].sort() }))
      .sort((a, b) => a.from.localeCompare(b.from) || a.to.localeCompare(b.to));
  }
  function manifestSnippet(c) {
    return "changes:\n  " + JSON.stringify(c.to) + ":\n    depends_on:\n      - " + JSON.stringify(c.from);
  }
  function firstRemaining(c) {
    for (const p of (c.phases || [])) for (const it of (p.items || [])) if (!it.done) return it.text;
    return progressOf(c).hasTasks ? "All complete" : "No tasks";
  }
  function kindTag(it) {
    const k = it.kind; if (!k || k === "task") return "";
    return '<span class="kind ' + esc(k) + '">' + esc(k) + "</span>";
  }
  function extRefChips(it) {
    return (it.externalRefs || []).map((r) => '<span class="ext-ref" title="' + esc(r.target) + '">' + esc(r.externalId) + "</span>").join("");
  }
  function destroyChart() { if (window.__chart) { window.__chart.destroy(); window.__chart = null; } }
  function destroyCy() { if (cyInstance) { cyInstance.destroy(); cyInstance = null; } }

  /* ---- task pipeline HTML (within-change) ---- */
  function pipelineHTML(c) {
    const phases = c.phases || [];
    if (!phases.length) return "";
    let h = '<div class="pipeline">';
    phases.forEach((p, pi) => {
      if (pi > 0) h += '<div class="pipe-arrow">&#8594;</div>';
      const items = p.items || [];
      const d = items.filter((i) => i.done).length;
      const pct = items.length ? Math.round((d / items.length) * 100) : 0;
      h += '<div class="pipe-stage">';
      h += '<div class="pipe-phase-head">Stage ' + esc(p.number) + ': ' + esc(p.name) + '</div>';
      h += '<div class="pipe-tasks">';
      items.forEach((it) => {
        h += '<div class="pipe-task' + (it.done ? ' done' : '') + '" title="' + esc(it.text) + '">' +
          '<span class="pipe-key">' + esc(it.key) + '</span>' +
          esc(it.text.length > 26 ? it.text.slice(0, 25) + '…' : it.text) + '</div>';
      });
      h += '</div><div class="pipe-bar"><span style="width:' + pct + '%"></span></div></div>';
    });
    h += '</div>';
    return h;
  }

  /* ---- inspector HTML (shared between graph hover + detail sidebar) ---- */
  function inspectorHTML(id) {
    const c = byName.get(id);
    if (!c) return '<p class="empty" style="margin-top:0">No detail entry for <code>' + esc(id) + '</code>.</p>';
    const p = progressOf(c);
    const deps = dependsOn(id), blks = blocks(id);
    return '<div style="display:flex;align-items:baseline;gap:.4rem;flex-wrap:wrap;margin-bottom:.5rem">' +
      '<strong>' + esc(c.name) + '</strong>' +
      '<span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + '</span></div>' +
      '<div class="meter" style="margin:.3rem 0 .2rem"><span style="width:' + p.pct + '%"></span></div>' +
      '<p class="metric">' + progressLabel(c) + '</p>' +
      (c.phases && c.phases.length ? '<p class="eyebrow" style="margin-top:.65rem">Task pipeline</p>' + pipelineHTML(c) : '') +
      '<p class="eyebrow">Depends on</p>' +
      (deps.length ? '<div class="chips">' + deps.map(chipLink).join("") + '</div>' : '<p class="none">Nothing upstream.</p>') +
      '<p class="eyebrow">Blocks</p>' +
      (blks.length ? '<div class="chips">' + blks.map(chipLink).join("") + '</div>' : '<p class="none">Nothing downstream.</p>') +
      '<p style="margin-top:.65rem"><a class="btn" href="#/c/' + encodeURIComponent(c.name) + '">Open detail</a></p>';
  }

  /* ================================================================
     GRAPH STATE — expand/collapse ontology: Changes → Stages
     Default view shows one node per change; double-click to expand
     into its constituent stages.
     ================================================================ */
  const expandedChanges = new Set();
  const trunc = (s, n) => s && s.length > n ? s.slice(0, n - 1) + "…" : (s || "");
  const phId  = (cn, pi) => cn + "\x00" + pi;

  function graphElems() {
    const elems = [];
    changes.forEach((c) => {
      const phases = c.phases || [];
      if (expandedChanges.has(c.name) && phases.length) {
        phases.forEach((p, pi) => {
          const id    = phId(c.name, pi);
          const items = p.items || [];
          const done  = items.filter((i) => i.done).length;
          const pct   = items.length ? Math.round(done / items.length * 100) : 0;
          elems.push({
            group: "nodes",
            data: { id, label: "Stage " + p.number + "\n" + trunc(p.name, 16), lifecycle: c.lifecycle || "proposed", changeId: c.name, type: "stage", pct, done, total: items.length },
          });
          if (pi > 0) elems.push({ group: "edges", data: { id: "seq:" + id, source: phId(c.name, pi - 1), target: id, type: "sequential" } });
        });
      } else {
        const prog  = progressOf(c);
        const label = trunc(c.name, 20) + "\n" + prog.pct + "% · " + phases.length + (phases.length === 1 ? " stage" : " stages");
        elems.push({
          group: "nodes",
          data: { id: c.name, label, lifecycle: c.lifecycle || "proposed", changeId: c.name, type: "change", pct: prog.pct, canExpand: phases.length > 0 },
        });
      }
    });
    const confirmed = new Set(edges.map((e) => e.from + ":" + e.to));
    edges.forEach((e) => {
      const fromC = byName.get(e.from), toC = byName.get(e.to);
      const fromPh = fromC && fromC.phases || [];
      const toPh   = toC  && toC.phases   || [];
      const fromExp = expandedChanges.has(e.from) && fromPh.length;
      const toExp   = expandedChanges.has(e.to)   && toPh.length;
      elems.push({ group: "edges", data: { id: "dep:" + e.from + ":" + e.to, source: fromExp ? phId(e.from, fromPh.length - 1) : e.from, target: toExp ? phId(e.to, 0) : e.to, type: "cross" } });
    });
    novelCandidateGroups().forEach((c) => {
      if (!confirmed.has(c.from + ":" + c.to)) {
        const fromC = byName.get(c.from), toC = byName.get(c.to);
        const fromPh = fromC && fromC.phases || [];
        const toPh   = toC  && toC.phases   || [];
        const fromExp = expandedChanges.has(c.from) && fromPh.length;
        const toExp   = expandedChanges.has(c.to)   && toPh.length;
        elems.push({ group: "edges", data: { id: "sug:" + c.from + ":" + c.to, source: fromExp ? phId(c.from, fromPh.length - 1) : c.from, target: toExp ? phId(c.to, 0) : c.to, suggested: true } });
      }
    });
    return elems;
  }

  /* LR (left-to-right) layout via BFS depth → preset positions */
  function lrPositions(elems) {
    const nids  = elems.filter((e) => e.group === "nodes").map((e) => e.data.id);
    const elist = elems.filter((e) => e.group === "edges" && !e.data.suggested);
    const inDeg = Object.fromEntries(nids.map((id) => [id, 0]));
    const adj   = Object.fromEntries(nids.map((id) => [id, []]));
    elist.forEach((e) => {
      if (inDeg[e.data.target] !== undefined) inDeg[e.data.target]++;
      if (adj[e.data.source]) adj[e.data.source].push(e.data.target);
    });
    const depth = Object.fromEntries(nids.map((id) => [id, 0]));
    const q = nids.filter((id) => inDeg[id] === 0);
    for (let head = 0; head < q.length; head++) {
      const id = q[head];
      (adj[id] || []).forEach((next) => {
        depth[next] = Math.max(depth[next], depth[id] + 1);
        if (--inDeg[next] === 0) q.push(next);
      });
    }
    const cols = {};
    elems.filter((e) => e.group === "nodes").forEach((n) => { (cols[depth[n.data.id] || 0] = cols[depth[n.data.id] || 0] || []).push(n); });
    const COL_W = 220, ROW_H = 90;
    const pos = {};
    Object.entries(cols).sort((a, b) => +a[0] - +b[0]).forEach(([d, ns]) => {
      ns.sort((a, b) => (a.data.changeId || "").localeCompare(b.data.changeId || "") || (a.data.id || "").localeCompare(b.data.id || ""));
      ns.forEach((n, i) => { pos[n.data.id] = { x: +d * COL_W, y: i * ROW_H }; });
    });
    return pos;
  }

  /* ---- Cytoscape graph initialiser ---- */
  function initCy(containerId) {
    if (typeof cytoscape === "undefined") {
      document.getElementById(containerId).innerHTML =
        '<div class="graph-empty">Cytoscape failed to load. Check network connection.</div>';
      return;
    }
    destroyCy();
    const elems = graphElems();
    const pos   = lrPositions(elems);

    cyInstance = cytoscape({
      container: document.getElementById(containerId),
      elements: elems,
      style: [
        { selector: "node", style: { shape: "rectangle", width: 160, height: 44, "background-color": "#fffefa", "border-width": 1.5, "border-color": "#111", label: "data(label)", "font-family": '"Monaco","Menlo",monospace', "font-size": 9, "text-valign": "center", "text-halign": "center", color: "#111", "text-wrap": "wrap", "text-max-width": 148 } },
        { selector: 'node[type = "change"]', style: { height: 52, "border-width": 2, "font-size": 10 } },
        { selector: 'node[lifecycle = "active"]',   style: { "background-color": "#fff1c8", "border-color": "#d0a53b" } },
        { selector: 'node[lifecycle = "proposed"]', style: { "background-color": "#dce6ff", "border-color": "#8ca7d9" } },
        { selector: 'node[lifecycle = "archived"]', style: { "background-color": "#dcf0df", "border-color": "#79aa80" } },
        { selector: "node.focused", style: { "border-width": 2.5, "border-color": "#002f86" } },
        { selector: "node.dim",     style: { opacity: 0.2 } },
        { selector: "edge", style: { "curve-style": "bezier", "target-arrow-shape": "triangle", "arrow-scale": 1, "line-color": "#999", "target-arrow-color": "#999", width: 1.5 } },
        { selector: 'edge[type = "cross"]', style: { "line-color": "#002f86", "target-arrow-color": "#002f86", width: 2, "line-style": "dashed", "line-dash-pattern": [8, 4] } },
        { selector: "edge[?suggested]",    style: { "line-color": "#ccc", "target-arrow-color": "#ccc", width: 1, "line-style": "dashed", "line-dash-pattern": [4, 4] } },
        { selector: "edge.dim",            style: { opacity: 0.08 } },
        { selector: "edge.focused",        style: { "line-color": "#002f86", "target-arrow-color": "#002f86" } },
      ],
      layout: { name: "preset", positions: (id) => pos[id] || { x: 0, y: 0 }, padding: 32 },
      userZoomingEnabled: true, userPanningEnabled: true, boxSelectionEnabled: false,
    });

    const inspBody = document.getElementById("graph-inspector-body");

    cyInstance.on("mouseover", "node", function (evt) {
      const node     = evt.target;
      const changeId = node.data("changeId") || node.id();
      if (inspBody) inspBody.innerHTML = inspectorHTML(changeId);
      cyInstance.elements().addClass("dim");
      cyInstance.nodes().filter((n) => (n.data("changeId") || n.id()) === changeId).removeClass("dim").addClass("focused");
      const conn = node.connectedEdges();
      conn.removeClass("dim").addClass("focused");
      conn.connectedNodes().removeClass("dim");
    });

    cyInstance.on("mouseout", "node", function () {
      cyInstance.elements().removeClass("dim focused");
      if (inspBody) inspBody.innerHTML = '<p class="empty" style="margin-top:0">Hover a node to inspect.</p>';
    });

    /* Double-click a change node: toggle expansion to stage nodes */
    cyInstance.on("dblclick", "node", function (evt) {
      const node     = evt.target;
      const changeId = node.data("changeId") || node.id();
      const type     = node.data("type");
      if (type === "change" && node.data("canExpand")) {
        if (expandedChanges.has(changeId)) expandedChanges.delete(changeId);
        else expandedChanges.add(changeId);
        initCy(containerId);
      }
    });

    /* Single tap on a stage node: navigate to its detail drilldown */
    cyInstance.on("tap", "node", function (evt) {
      const type     = evt.target.data("type");
      const changeId = evt.target.data("changeId") || evt.target.id();
      if (type === "stage" && byName.has(changeId)) location.hash = "#/c/" + encodeURIComponent(changeId);
    });

    cyInstance.fit();
  }

  /* ---- phase progress chart ---- */
  function cssVar(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim() || "#888"; }
  function initPhaseChart(c) {
    if (typeof Chart === "undefined") return;
    const ctx = document.getElementById("phasechart");
    if (!ctx) return;
    const labels = c.phases.map((p) => "Stage " + p.number);
    const done   = c.phases.map((p) => p.items.filter((i) => i.done).length);
    const rem    = c.phases.map((p) => p.items.length - p.items.filter((i) => i.done).length);
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ink = cssVar("--ink"), muted = cssVar("--muted"), surface = cssVar("--surface-2");
    window.__chart = new Chart(ctx, {
      type: "bar",
      data: {
        labels,
        datasets: [
          { label: "Done", data: done, backgroundColor: ink, borderWidth: 0, borderRadius: 0 },
          { label: "Rem",  data: rem,  backgroundColor: surface, borderWidth: 1, borderColor: muted, borderRadius: 0 },
        ],
      },
      options: {
        indexAxis: "y", responsive: true, maintainAspectRatio: false,
        animation: reduce ? false : { duration: 200 },
        scales: {
          x: { stacked: true, beginAtZero: true, ticks: { precision: 0, font: { family: "monospace", size: 10 }, color: muted }, grid: { display: false } },
          y: { stacked: true, ticks: { font: { family: "monospace", size: 10 }, color: ink }, grid: { display: false } },
        },
        plugins: { legend: { display: false } },
      },
    });
  }

  /* ---- stat tile ---- */
  function stat(n, label) {
    return '<div class="stat"><b class="tnum">' + (n || 0) + "</b><span>" + label + "</span></div>";
  }

  /* ================================================================
     KANBAN VIEW
     ================================================================ */
  function renderKanban() {
    destroyChart(); destroyCy();
    const tally = { active: 0, proposed: 0, archived: 0 };
    let done = 0, total = 0;
    changes.forEach((c) => {
      const p = progressOf(c);
      tally[c.lifecycle] = (tally[c.lifecycle] || 0) + 1;
      done += p.done; total += p.total;
    });
    const pct = total ? Math.round((done / total) * 100) : 0;

    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.65rem">Changes</h1>';
    h += '<div class="tally">' +
      stat(tally.active,   "active")   +
      stat(tally.proposed, "proposed") +
      stat(tally.archived, "archived") +
      '<div class="stat"><b class="tnum">' + done +
      '<span style="font-size:.6em;font-weight:400;color:var(--muted)">/' + total + '</span></b>' +
      '<span>tasks · ' + pct + '%</span></div></div>';

    h += '<div class="board">';
    LIFECYCLES.forEach((lc) => {
      const col = changes.filter((c) => c.lifecycle === lc);
      h += '<section class="col"><div class="col-head"><span class="badge ' + lc + '">' + lc +
        '</span><span class="ct">' + col.length + "</span></div><div class=\"col-body\">";
      if (!col.length) {
        h += '<p class="empty-col">None</p>';
      } else {
        col.forEach((c) => {
          const p = progressOf(c);
          const stgCount = (c.phases || []).length;
          h += '<button class="bcard" data-change="' + esc(c.name) + '">' +
            "<h3>" + esc(c.name) + "</h3>" +
            '<div class="meter"><span style="width:' + p.pct + '%"></span></div>' +
            '<p class="sub">' + progressLabel(c) + " &middot; " + stgCount + (stgCount === 1 ? " stage" : " stages") + "</p></button>";
        });
      }
      h += "</div></section>";
    });
    h += "</div>";

    view.innerHTML = h;
    document.querySelectorAll(".bcard[data-change]").forEach((btn) => {
      btn.addEventListener("click", () => {
        location.hash = "#/c/" + encodeURIComponent(btn.getAttribute("data-change"));
      });
    });
    afterRender();
  }

  /* ================================================================
     GRAPH VIEW
     ================================================================ */
  function renderGraph() {
    destroyChart(); destroyCy();
    const novel = novelCandidateGroups();

    let h = '<h1 tabindex="-1" id="view-title" style="margin-bottom:.5rem">Dependency Graph</h1>';
    if (!changes.length) {
      h += '<div class="graph-empty">No changes found.</div>';
      view.innerHTML = h; afterRender(); return;
    }

    h += '<div class="graph-toolbar">';
    h += '<button class="btn" id="btn-expand-all">Expand all</button>';
    h += '<button class="btn" id="btn-collapse-all">Collapse all</button>';
    h += '<span class="graph-hint-text">double-click a change to expand its stages</span>';
    h += '</div>';

    h += '<div class="graph-shell">';
    h += '<div class="graph-workbench">' +
      '<div id="cy-container"></div>' +
      '<div class="graph-legend">' +
      '<span class="legend-item"><span class="legend-line sequential"></span> sequential</span>' +
      '<span class="legend-item"><span class="legend-line cross"></span> cross-change dep</span>' +
      '<span class="legend-item"><span class="legend-line suggested"></span> suggested</span>' +
      '</div>' +
      '</div>';
    h += '<aside class="graph-inspector">' +
      '<div class="graph-inspector-head"><span>Inspector</span></div>' +
      '<div class="graph-inspector-body" id="graph-inspector-body">' +
      '<p class="empty" style="margin-top:0">Hover a node to inspect.</p>' +
      '</div></aside></div>';

    if (novel.length) {
      h += '<div class="suggest-panel"><div class="suggest-head"><span>Suggested edges</span> &mdash; inferred from shared capabilities (' + novel.length + ')</div>';
      h += '<div class="suggest-body"><table class="suggest-table"><thead><tr>' +
        '<th>From (prerequisite)</th><th>To (dependent)</th><th>Shared capabilities</th><th>Add to specutil.yaml</th>' +
        '</tr></thead><tbody>';
      novel.forEach((c) => {
        h += '<tr><td>' + chipLink(c.from) + '</td><td>' + chipLink(c.to) + '</td>' +
          '<td>' + c.capabilities.map((cap) => '<code>' + esc(cap) + '</code>').join(" ") + '</td>' +
          '<td><code style="font-size:10px;white-space:pre">' + esc(manifestSnippet(c)) + '</code></td></tr>';
      });
      h += '</tbody></table></div></div>';
    }

    view.innerHTML = h;
    initCy("cy-container");

    const btnExpAll = document.getElementById("btn-expand-all");
    const btnColAll = document.getElementById("btn-collapse-all");
    if (btnExpAll) btnExpAll.addEventListener("click", () => {
      changes.forEach((c) => { if ((c.phases || []).length) expandedChanges.add(c.name); });
      initCy("cy-container");
    });
    if (btnColAll) btnColAll.addEventListener("click", () => {
      expandedChanges.clear();
      initCy("cy-container");
    });

    afterRender();
  }

  /* ================================================================
     DRILLDOWN VIEW
     ================================================================ */
  function taskRowHTML(it) {
    const done = it.done;
    const refs  = (it.externalRefs || []).map((r) => '<span class="task-ext" title="' + esc(r.target) + '">' + esc(r.externalId) + "</span>").join("");
    const k     = it.kind && it.kind !== "task" ? '<span class="kind ' + esc(it.kind) + '">' + esc(it.kind) + "</span>" : "";
    return '<div class="task-row' + (done ? " done" : "") + '">' +
      '<div class="task-check' + (done ? " done" : "") + '">' + (done ? "&#10003;" : "&#9744;") + "</div>" +
      '<div class="task-key">' + esc(it.key) + "</div>" +
      '<div class="task-body">' + k + '<span class="task-title" title="' + esc(it.text) + '">' + esc(it.text) + "</span></div>" +
      '<div class="task-meta">' + refs + "</div>" +
      "</div>";
  }

  function renderDetail(name) {
    destroyChart(); destroyCy();
    const c = byName.get(name);
    if (!c) { renderKanban(); return; }
    const prog = progressOf(c);
    const deps = dependsOn(name), blks = blocks(name);

    let h = '<a class="back" href="#/">&#9664; All changes</a>';
    h += '<div class="doc"><div style="display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-bottom:.65rem">';
    h += '<h1 tabindex="-1" id="view-title">' + esc(c.name) + "</h1>";
    h += '<span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span></div>";
    h += '<div class="doclayout"><div class="main">';

    /* Task pipeline — accurate hint: deps gate tasks, not stage order */
    if ((c.phases || []).length) {
      h += '<p class="eyebrow" style="margin-top:0">Execution plan &mdash; tasks run when their dependencies are met</p>';
      h += pipelineHTML(c);
    }

    /* Narrative — collapsed by default (progressive disclosure) */
    if (c.why || c.whatChanges) {
      h += '<div class="narrative">';
      if (c.why) {
        h += '<details class="narrative-block"><summary class="narrative-summary">Why</summary>' +
          '<div class="narrative-body">' + md(c.why) + '</div></details>';
      }
      if (c.whatChanges) {
        h += '<details class="narrative-block"><summary class="narrative-summary">What changes</summary>' +
          '<div class="narrative-body">' + md(c.whatChanges) + '</div></details>';
      }
      h += '</div>';
    }

    /* Tasks by stage — all closed by default; open-task stages get accent border */
    h += '<p class="eyebrow" style="margin-top:1.25rem">Tasks by stage</p>';
    (c.phases || []).forEach((p, _pi) => {
      const items  = p.items || [];
      const done   = items.filter((i) => i.done).length;
      const phPct  = items.length ? Math.round((done / items.length) * 100) : 0;
      const open   = done < items.length;
      h += '<details class="phase-block' + (open ? " has-open" : "") + '"><summary class="phase-h">' +
        '<h2>' + esc(p.number) + ". " + esc(p.name) +
        (open ? '<span class="phase-open-badge">' + (items.length - done) + ' open</span>' : "") +
        "</h2>" +
        '<span class="ct tnum">' + done + "/" + items.length + " &middot; " + phPct + "%</span></summary>";
      h += '<div class="meter" style="margin:.2rem 0 .4rem"><span style="width:' + phPct + '%"></span></div>';
      h += '<div class="task-list">';
      items.forEach((it) => { h += taskRowHTML(it); });
      h += "</div></details>";
    });

    h += "</div>"; /* end .main */

    /* Rail — Dependencies first, then Progress */
    h += '<aside class="rail">';

    h += '<div class="panel"><div class="panel-title"><span class="panel-title-label">Dependencies</span></div><div class="panel-body">';
    h += '<p class="eyebrow" style="margin-top:0">Depends on</p>';
    h += deps.length ? '<div class="chips">' + deps.map(chipLink).join("") + "</div>" : '<p class="none">Nothing upstream.</p>';
    h += '<p class="eyebrow">Blocks</p>';
    h += blks.length ? '<div class="chips">' + blks.map(chipLink).join("") + "</div>" : '<p class="none">Nothing downstream.</p>';
    h += "</div></div>";

    h += '<div class="panel"><div class="panel-title"><span class="panel-title-label">Progress</span></div><div class="panel-body">';
    h += '<div class="progress-big"><span class="num">' + prog.pct + '</span>' +
      '<span style="font-family:var(--font-mono);font-size:.875rem;color:var(--muted)">%</span>' +
      '<p class="label">' + progressLabel(c) + "</p></div>";
    h += '<div class="meter" style="margin:.4rem 0"><span style="width:' + prog.pct + '%"></span></div>';
    if ((c.phases || []).length) {
      h += '<div class="chartwrap" style="height:' + (c.phases.length * 26 + 14) + 'px">' +
        '<canvas id="phasechart"></canvas></div>';
    }
    h += "</div></div>";

    h += "</aside>";
    h += "</div></div>"; /* end doclayout + doc */

    view.innerHTML = h;
    if ((c.phases || []).length) initPhaseChart(c);
    afterRender();
  }

  /* ---- empty state ---- */
  function renderEmpty() {
    destroyChart(); destroyCy();
    view.innerHTML = '<h1 tabindex="-1" id="view-title">No changes found</h1>' +
      '<p class="empty" style="margin-top:.5rem">Create changes under <code>openspec/changes/&lt;name&gt;/</code>, then run <code>specutil web</code>.</p>';
    afterRender();
  }

  /* ---- routing ---- */
  function route() {
    if (!changes.length) { currentRoute = "/"; renderEmpty(); return; }
    const h = location.hash.replace(/^#/, "");
    const m = h.match(/^\/c\/(.+)$/);
    if (m) {
      const name = decodeURIComponent(m[1]);
      if (byName.has(name)) { currentRoute = "/c/" + name; renderDetail(name); return; }
    }
    if (h === "/graph") { currentRoute = "/graph"; renderGraph(); return; }
    currentRoute = "/"; renderKanban();
  }

  /* ---- tabs + afterRender ---- */
  function afterRender() {
    const t = document.getElementById("view-title");
    if (t) { t.focus(); if (live) live.textContent = t.textContent; }
    syncTabs();
  }
  const navTabs = document.getElementById("nav-tabs");
  function syncTabs() {
    navTabs.querySelectorAll("a").forEach((a) => {
      const r = a.getAttribute("data-route");
      const on = (r === "/" && (currentRoute === "/" || currentRoute.startsWith("/c/"))) ||
                 (r === "/graph" && currentRoute === "/graph");
      a.classList.toggle("on", !!on);
    });
  }
  if (changes.length) {
    [["/" , "Kanban"], ["/graph", "Graph"]].forEach(([r, label]) => {
      const a = document.createElement("a");
      a.href = "#" + r; a.textContent = label; a.setAttribute("data-route", r);
      navTabs.appendChild(a);
    });
  }

  /* ---- diagnostics banner ---- */
  const bannerIssues = diags.concat(feedIssues);
  if (bannerIssues.length) {
    const b = document.getElementById("diag-banner");
    const kinds = [...new Set(bannerIssues.map((d) => d.kind))].join(", ");
    b.innerHTML = "<b>Data problems (" + esc(kinds) + "):</b><ul>" +
      bannerIssues.map((d) => "<li>" + esc(d.msg) + "</li>").join("") + "</ul>";
    b.hidden = false;
  }
  if (window.__cdnFail && window.__cdnFail.length) document.getElementById("offline-note").hidden = false;

  window.addEventListener("hashchange", route);
  route();
})();
</script>
</body>
</html>
