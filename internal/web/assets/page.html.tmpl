<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>specutil</title>
<!-- Pre-paint theme: apply a stored override before the stylesheet so the page
     never flashes the wrong theme. With no override we leave data-theme unset and
     fall back to prefers-color-scheme (handled in CSS, and honored by Pico). -->
<script>
(function () {
  try {
    var t = localStorage.getItem("specutil-theme");
    if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
  } catch (e) {}
})();
</script>
<!-- Runtime deps load from a pinned, SRI-protected CDN (no vendored/committed
     bundles). The binary still performs zero network I/O — it only writes this
     static file. onerror flags a CDN miss so the page can warn instead of
     silently rendering blank/unstyled when opened offline. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2.0.6/css/pico.min.css" integrity="sha384-7P0NVe9LPDbUCAF+fH2R8Egwz1uqNH83Ns/bfJY0fN2XCDBMUI2S9gGzIOIRBKsA" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('pico')">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous" onerror="(window.__cdnFail=window.__cdnFail||[]).push('chart')"></script>
<style>
  /* ---- Theme tokens. Light is the default; dark applies either when the OS
     prefers it (and no explicit light override) or when data-theme="dark" is
     forced. Every color below is a variable so the SVG graph, the chart, and the
     board all track the theme with no per-component duplication. ---- */
  :root {
    --bg: #ffffff;
    --surface: #ffffff;
    --surface-2: #f8fafc;
    --ink: #0f172a;
    --muted: #64748b;
    --line: #e5e7eb;
    --line-strong: #cbd5e1;
    --track: #e2e8f0;
    --accent: #2563eb;
    --code-bg: #f1f5f9;
    --code-ink: #475569;

    --lc-proposed-bg: #f1f5f9; --lc-proposed-ink: #475569; --lc-proposed-line: #e2e8f0;
    --lc-active-bg:   #fef3c7; --lc-active-ink:   #b45309; --lc-active-line:   #fde68a;
    --lc-archived-bg: #dcfce7; --lc-archived-ink: #15803d; --lc-archived-line: #bbf7d0;

    --done: #15803d;
    --node-bg: var(--surface);
    --node-stroke: var(--line-strong);
    --edge: #94a3b8;

    --warn-bg: #fef3c7; --warn-line: #fde68a; --warn-ink: #92400e;
    --danger-bg: #fee2e2; --danger-line: #fecaca; --danger-ink: #b91c1c;
  }
  /* Dark via system preference (unless the user forced light). */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0b1120; --surface: #111827; --surface-2: #0f172a;
      --ink: #e2e8f0; --muted: #94a3b8; --line: #1f2937; --line-strong: #334155;
      --track: #1f2937; --accent: #60a5fa; --code-bg: #1e293b; --code-ink: #cbd5e1;
      --lc-proposed-bg: #1e293b; --lc-proposed-ink: #cbd5e1; --lc-proposed-line: #334155;
      --lc-active-bg:   #422006; --lc-active-ink:   #fbbf24; --lc-active-line:   #854d0e;
      --lc-archived-bg: #052e16; --lc-archived-ink: #4ade80; --lc-archived-line: #166534;
      --done: #4ade80; --node-bg: #1e293b; --node-stroke: #334155; --edge: #475569;
      --warn-bg: #422006; --warn-line: #854d0e; --warn-ink: #fbbf24;
      --danger-bg: #450a0a; --danger-line: #7f1d1d; --danger-ink: #fca5a5;
    }
  }
  /* Dark forced by the toggle. */
  :root[data-theme="dark"] {
    --bg: #0b1120; --surface: #111827; --surface-2: #0f172a;
    --ink: #e2e8f0; --muted: #94a3b8; --line: #1f2937; --line-strong: #334155;
    --track: #1f2937; --accent: #60a5fa; --code-bg: #1e293b; --code-ink: #cbd5e1;
    --lc-proposed-bg: #1e293b; --lc-proposed-ink: #cbd5e1; --lc-proposed-line: #334155;
    --lc-active-bg:   #422006; --lc-active-ink:   #fbbf24; --lc-active-line:   #854d0e;
    --lc-archived-bg: #052e16; --lc-archived-ink: #4ade80; --lc-archived-line: #166534;
    --done: #4ade80; --node-bg: #1e293b; --node-stroke: #334155; --edge: #475569;
    --warn-bg: #422006; --warn-line: #854d0e; --warn-ink: #fbbf24;
    --danger-bg: #450a0a; --danger-line: #7f1d1d; --danger-ink: #fca5a5;
  }

  html { font-size: 16px; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink); background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 66rem; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
  h1, h2, h3 { letter-spacing: -0.011em; font-weight: 600; line-height: 1.2; color: var(--ink); }
  h1 { font-size: 2rem; letter-spacing: -0.02em; margin: 0 0 .25rem; }
  h2 { font-size: 1.375rem; margin: 2rem 0 .5rem; }
  h3 { font-size: 1.0625rem; margin: 0; }
  h1:focus, h2:focus { outline: none; }
  a { color: var(--accent); }
  .tnum { font-variant-numeric: tabular-nums; }

  /* ---- App bar: brand, view tabs, theme toggle, jump select ---- */
  .appbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .75rem 1rem; border-bottom: 1px solid var(--line); padding-bottom: .85rem; margin-bottom: 1.5rem; }
  .appbar .brand { font-weight: 600; letter-spacing: -0.01em; color: inherit; text-decoration: none; font-size: 1.05rem; }
  .appbar .right { display: flex; align-items: center; gap: .5rem; }
  .appbar select { font-size: .875rem; padding: .25rem .5rem; border: 1px solid var(--line); border-radius: 8px; margin: 0; width: auto; background: var(--surface); color: var(--ink); }
  .tabs { display: flex; gap: .25rem; }
  .tabs a { font-size: .8125rem; font-weight: 500; padding: .3rem .7rem; border-radius: 8px; text-decoration: none; color: var(--muted); }
  .tabs a:hover { background: var(--surface-2); color: var(--ink); }
  .tabs a.on { background: var(--accent); color: #fff; }
  .toggle { font: inherit; font-size: .8125rem; cursor: pointer; padding: .3rem .6rem; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--ink); display: inline-flex; align-items: center; gap: .35rem; width: auto; }
  .toggle:hover { border-color: var(--line-strong); }

  .eyebrow { font-size: .6875rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 1.75rem 0 .5rem; }

  .badge { display: inline-block; font-size: .6875rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: .125rem .5rem; border-radius: 6px; border: 1px solid transparent; vertical-align: middle; }
  .badge.proposed { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
  .badge.active   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
  .badge.archived { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }

  .meter { height: 6px; border-radius: 999px; background: var(--track); overflow: hidden; margin: .5rem 0; }
  .meter > span { display: block; height: 100%; background: var(--accent); border-radius: 999px; }
  .metric { font-size: .9rem; color: var(--muted); margin: 0; }

  /* ---- Overview tally + cross-change roll-up ---- */
  .tally { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  .stat { border: 1px solid var(--line); border-radius: 10px; padding: .65rem 1rem; min-width: 6rem; background: var(--surface); }
  .stat b { display: block; font-size: 1.5rem; font-weight: 600; }
  .stat span { font-size: .72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .stat.rollup { border-left: 3px solid var(--accent); }

  /* ---- Card grid (overview) ---- */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
  .card { display: block; border: 1px solid var(--line); border-radius: 12px; padding: 1.25rem; text-decoration: none; color: inherit; background: var(--surface); transition: border-color .12s, box-shadow .12s; }
  .card:hover { border-color: var(--line-strong); box-shadow: 0 1px 2px rgba(2,6,23,.08); }
  .card .row { display: flex; justify-content: space-between; align-items: start; gap: .5rem; }
  .card .why { color: var(--muted); font-size: .875rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: .6rem 0 0; }
  .card .sub { font-size: .8125rem; color: var(--muted); margin: .5rem 0 0; }
  .card.lc-active   { border-top: 3px solid var(--lc-active-line); }
  .card.lc-proposed { border-top: 3px solid var(--lc-proposed-line); }
  .card.lc-archived { border-top: 3px solid var(--lc-archived-line); }

  /* ---- Board: lifecycle columns ---- */
  .board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; align-items: start; }
  .board .col { background: var(--surface-2); border: 1px solid var(--line); border-radius: 12px; padding: .85rem; min-height: 6rem; }
  .board .col > header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .75rem; }
  .board .col > header .ct { font-size: .8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .board .bcard { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: .75rem .85rem; margin-bottom: .65rem; text-decoration: none; color: inherit; }
  .board .bcard:last-child { margin-bottom: 0; }
  .board .bcard:hover { border-color: var(--line-strong); }
  .board .bcard h3 { font-size: .95rem; }
  .board .bcard .sub { font-size: .75rem; color: var(--muted); margin: .35rem 0 0; }
  .board .empty-col { font-size: .8125rem; color: var(--muted); }
  @media (max-width: 48rem) { .board { grid-template-columns: 1fr; } }

  /* ---- Graph view (full-width) + inline SVG theming ---- */
  .dagwrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; padding: .75rem; background: var(--surface); margin-top: 1rem; }
  .dagwrap svg text { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  .dagwrap .nbox { fill: var(--node-bg); stroke: var(--node-stroke); transition: opacity .12s; }
  .dagwrap .nlabel { fill: var(--ink); }
  .dagwrap .lc-proposed .nbox { fill: var(--lc-proposed-bg); stroke: var(--lc-proposed-line); }
  .dagwrap .lc-active   .nbox { fill: var(--lc-active-bg);   stroke: var(--lc-active-line); }
  .dagwrap .lc-archived .nbox { fill: var(--lc-archived-bg); stroke: var(--lc-archived-line); }
  .dagwrap .node { cursor: pointer; }
  .dagwrap .node:focus { outline: none; }
  .dagwrap .node:focus .nbox { stroke: var(--accent); stroke-width: 2; }
  .dagwrap .edge { stroke: var(--edge); transition: opacity .12s; }
  .dagwrap .arrow path { fill: var(--edge); }
  /* CSS-only focus+context: hovering or targeting a node dims the rest so the
     incident node stands out; a small JS enhancement (below) additionally lifts
     its immediate neighbors and incident edges. Degrades to all-visible with no
     CSS/JS. */
  .dagwrap:hover .node:not(:hover) { opacity: .4; }
  .dagwrap.emph .node:not(.lit) { opacity: .35; }
  .dagwrap.emph .edge:not(.lit) { opacity: .2; }
  .dagwrap .node.lit .nbox { stroke-width: 2; }

  /* ---- Two-column document: checklist main + sticky relationships rail ---- */
  .doc { margin-top: .5rem; }
  .doclayout { display: grid; grid-template-columns: 1fr 17rem; gap: 2rem; align-items: start; }
  .doclayout .rail { position: sticky; top: 1rem; }
  .rail .panel { border: 1px solid var(--line); border-radius: 12px; padding: 1rem; background: var(--surface); }
  .rail .panel + .panel { margin-top: 1rem; }
  .rail .eyebrow { margin-top: 0; }
  @media (max-width: 52rem) { .doclayout { grid-template-columns: 1fr; } .doclayout .rail { position: static; } }

  .chartwrap { margin: .5rem 0; }
  .remaining { border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 10px; padding: .5rem 1rem; background: var(--surface-2); }
  .alldone { color: var(--done); font-weight: 600; }

  ul.tasks { list-style: none; padding: 0; margin: .35rem 0 0; }
  ul.tasks li { display: flex; gap: .55rem; align-items: baseline; padding: .375rem 0; border-bottom: 1px solid var(--line); }
  ul.tasks li:last-child { border-bottom: 0; }
  ul.tasks li.done .txt { color: var(--muted); }
  .key { flex: 0 0 auto; min-width: 2rem; text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; background: var(--code-bg); color: var(--code-ink); border-radius: 5px; padding: .0625rem .375rem; }
  .glyph { flex: 0 0 auto; width: 1.1rem; text-align: center; }
  .glyph.done { color: var(--done); }
  .glyph.todo { color: var(--muted); }
  .txt { flex: 1; }
  /* Task-kind markers: small uppercase tag distinguishing verify/apply/confirm
     from plain work. Plain ("task") items get none. */
  .kind { flex: 0 0 auto; font-size: .625rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; padding: .0625rem .3rem; border-radius: 4px; border: 1px solid transparent; }
  .kind.verify  { background: var(--lc-proposed-bg); color: var(--lc-proposed-ink); border-color: var(--lc-proposed-line); }
  .kind.apply   { background: var(--lc-active-bg);   color: var(--lc-active-ink);   border-color: var(--lc-active-line); }
  .kind.confirm { background: var(--lc-archived-bg); color: var(--lc-archived-ink); border-color: var(--lc-archived-line); }
  .phase-h { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1.5rem; }
  .phase-h h2 { margin: 0; }
  .phase-h .ct { font-size: .8125rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  .chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
  .chip { display: inline-block; font-size: .8125rem; padding: .125rem .625rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--accent); }
  .chip:hover { border-color: var(--line-strong); }
  .rail .none { font-size: .8125rem; color: var(--muted); margin: .25rem 0 0; }

  .back { display: inline-block; font-size: .875rem; margin-bottom: 1rem; color: var(--accent); text-decoration: none; }
  .back:hover { text-decoration: underline; }

  .doc p { line-height: 1.6; }
  .doc ul.md { margin: .25rem 0 .75rem; padding-left: 1.25rem; }
  .doc ul.md li { margin: .25rem 0; line-height: 1.55; }
  code { background: var(--code-bg); border-radius: 4px; padding: .0625rem .25rem; font-size: .875em; color: var(--code-ink); }

  /* ---- Banners ---- */
  #offline-note { background: var(--warn-bg); border: 1px solid var(--warn-line); color: var(--warn-ink); border-radius: 8px; padding: .625rem .875rem; font-size: .875rem; margin-bottom: 1rem; }
  #diag-banner { background: var(--danger-bg); border: 1px solid var(--danger-line); color: var(--danger-ink); border-radius: 8px; padding: .625rem .875rem; font-size: .875rem; margin-bottom: 1rem; }
  #diag-banner b { font-weight: 600; }
  #diag-banner ul { margin: .35rem 0 0; padding-left: 1.1rem; }
  .empty { color: var(--muted); max-width: 36rem; line-height: 1.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>
<div class="wrap">
  <header class="appbar" id="appbar">
    <a class="brand" href="#/">specutil</a>
    <div class="right" id="appbar-right"></div>
  </header>
  <div id="diag-banner" hidden></div>
  <div id="offline-note" hidden>This page loads styling and charts from a CDN and needs network access. Some visuals may be missing offline — the task content below is still readable.</div>
  <div id="live" class="sr-only" aria-live="polite"></div>
  <main id="view"></main>
  <noscript><p>This visualizer renders its content with JavaScript. Enable JavaScript to view the workstreams.</p></noscript>
</div>

<!-- Cross-change dependency DAG, pre-rendered as inline SVG in Go (empty unless
     there are 2+ changes with manifest edges). Cloned into the overview and the
     dedicated graph view. -->
<template id="dag">{{.DagSVG}}</template>

<script>
// Renderer-independent feeds, inlined as JS literals so the page needs no data
// files. GRAPH is the pure cross-change dependency DAG (change nodes + edges);
// DETAIL carries per-workstream content, each task tagged with its 0-based level
// (phase rank), key (0a, 0b, 1a, …) and kind (task/verify/apply/confirm); DIAG
// carries manifest diagnostics (cycles, dangling refs). json.Marshal escaped
// <, >, & so these literals cannot break out of the <script> block.
const GRAPH = {{.GraphJSON}};
const DETAIL = {{.DetailJSON}};
const DIAG = {{.DiagJSON}};
</script>

<script>
(function () {
  const changes = (DETAIL && DETAIL.changes) || [];
  const edges = (GRAPH && GRAPH.edges) || [];
  const diags = DIAG || [];
  const byName = new Map(changes.map((c) => [c.name, c]));
  const single = changes.length === 1;
  const multi = changes.length > 1;

  const view = document.getElementById("view");
  const live = document.getElementById("live");
  let sel = null;

  // ---- escaping + minimal markdown (flat bullets + inline code only) --------
  const esc = (s) => String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  const inline = (s) => s
    .replace(/`([^`]+)`/g, (_, c) => "<code>" + c + "</code>")
    .replace(/\*\*([^*]+)\*\*/g, (_, c) => "<strong>" + c + "</strong>");
  function md(src) {
    const lines = String(src || "").split(/\r?\n/);
    let html = "", inList = false, para = [];
    const flushPara = () => { if (para.length) { html += "<p>" + inline(esc(para.join(" "))) + "</p>"; para = []; } };
    const closeList = () => { if (inList) { html += "</ul>"; inList = false; } };
    for (const raw of lines) {
      const line = raw.replace(/\s+$/, "");
      const item = line.match(/^\s*[-*]\s+(.*)$/);
      if (item) { flushPara(); if (!inList) { html += '<ul class="md">'; inList = true; } html += "<li>" + inline(esc(item[1])) + "</li>"; continue; }
      if (line.trim() === "") { flushPara(); closeList(); continue; }
      closeList(); para.push(line.trim());
    }
    flushPara(); closeList();
    return html;
  }

  // ---- derived helpers ------------------------------------------------------
  const pctOf = (c) => (c.total ? Math.round((c.done / c.total) * 100) : 0);
  const dependsOn = (name) => edges.filter((e) => e.to === name).map((e) => e.from).sort();
  const blocks = (name) => edges.filter((e) => e.from === name).map((e) => e.to).sort();
  const chipLink = (n) => '<a class="chip" href="#/c/' + encodeURIComponent(n) + '">' + esc(n) + "</a>";
  const LIFECYCLES = ["proposed", "active", "archived"];

  function destroyChart() { if (window.__chart) { window.__chart.destroy(); window.__chart = null; } }

  function afterRender() {
    const t = document.getElementById("view-title");
    if (t) { t.focus(); if (live) live.textContent = t.textContent + " view"; }
    syncTabs();
  }

  // ---- per-phase progress chart (the one place Chart.js earns its keep) ------
  // Colors are read from the resolved CSS variables so the chart matches the
  // active theme; re-rendered on theme change (see the toggle handler).
  function cssVar(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim() || "#888";
  }
  function phaseChartLabel(c) {
    return "Progress by phase. " + (c.phases || []).map((p) => {
      const d = p.items.filter((i) => i.done).length;
      return "Phase " + p.number + ", " + d + " of " + p.items.length + " complete";
    }).join(". ");
  }
  function initPhaseChart(c) {
    if (typeof Chart === "undefined") return; // CDN miss / offline — sr-only list still conveys it
    const ctx = document.getElementById("phasechart");
    if (!ctx) return;
    const labels = c.phases.map((p) => "Phase " + p.number);
    const done = c.phases.map((p) => p.items.filter((i) => i.done).length);
    const rem = c.phases.map((p) => p.items.length - p.items.filter((i) => i.done).length);
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const accent = cssVar("--accent"), track = cssVar("--track"), muted = cssVar("--muted"), ink = cssVar("--ink");
    window.__chartChange = c.name;
    window.__chart = new Chart(ctx, {
      type: "bar",
      data: { labels, datasets: [
        { label: "Done", data: done, backgroundColor: accent, borderWidth: 0, borderRadius: 3 },
        { label: "Remaining", data: rem, backgroundColor: track, borderWidth: 0, borderRadius: 3 },
      ] },
      options: {
        indexAxis: "y", responsive: true, maintainAspectRatio: false,
        animation: reduce ? false : { duration: 300 },
        scales: {
          x: { stacked: true, beginAtZero: true, ticks: { precision: 0, font: { size: 12 }, color: muted }, grid: { display: false } },
          y: { stacked: true, ticks: { font: { size: 12 }, color: ink }, grid: { display: false } },
        },
        plugins: { legend: { display: false } },
      },
    });
  }

  // ---- inline SVG DAG: clone + wire optional hover emphasis -----------------
  function hasDag() {
    const t = document.getElementById("dag");
    return t && t.content && t.content.childElementCount > 0;
  }
  function mountDag(slot) {
    const t = document.getElementById("dag");
    slot.appendChild(t.content.cloneNode(true));
    const svg = slot.querySelector("svg");
    if (!svg) return;
    // Progressive enhancement: hovering a node lights its incident edges and
    // immediate neighbors. With JS off, the CSS :hover dimming still applies and
    // the anchors still navigate.
    const nodes = Array.from(svg.querySelectorAll(".node"));
    const lines = Array.from(svg.querySelectorAll(".edge"));
    nodes.forEach((n) => {
      n.addEventListener("mouseenter", () => {
        const id = n.getAttribute("data-node");
        const nbrs = new Set([id]);
        lines.forEach((l) => {
          const f = l.getAttribute("data-from"), tt = l.getAttribute("data-to");
          if (f === id || tt === id) { l.classList.add("lit"); nbrs.add(f); nbrs.add(tt); }
        });
        nodes.forEach((m) => { if (nbrs.has(m.getAttribute("data-node"))) m.classList.add("lit"); });
        slot.classList.add("emph");
      });
      n.addEventListener("mouseleave", () => {
        slot.classList.remove("emph");
        nodes.forEach((m) => m.classList.remove("lit"));
        lines.forEach((l) => l.classList.remove("lit"));
      });
    });
  }

  // ---- views ----------------------------------------------------------------
  function renderEmpty() {
    view.innerHTML =
      '<h1 tabindex="-1" id="view-title">No workstreams</h1>' +
      '<p class="empty">Create changes under <code>openspec/changes/&lt;name&gt;/</code>, ' +
      "define cross-change dependencies in <code>openspec/specutil.yaml</code> " +
      "(or run <code>specutil graph --suggest</code>), then regenerate this page.</p>";
    afterRender();
  }

  function stat(n, label, cls) { return '<div class="stat' + (cls ? " " + cls : "") + '"><b class="tnum">' + (n || 0) + "</b><span>" + label + "</span></div>"; }

  function renderOverview() {
    const tally = { active: 0, proposed: 0, archived: 0 };
    let done = 0, total = 0;
    changes.forEach((c) => { tally[c.lifecycle] = (tally[c.lifecycle] || 0) + 1; done += c.done; total += c.total; });

    let h = '<h1 tabindex="-1" id="view-title">Workstreams</h1>';
    h += '<div class="tally">' +
      stat(tally.active, "active") + stat(tally.proposed, "proposed") + stat(tally.archived, "archived") +
      // Cross-change roll-up: overall completed vs. total tasks across all changes.
      '<div class="stat rollup"><b class="tnum">' + done + " / " + total + '</b><span>tasks done</span></div>' +
      "</div>";

    h += '<div class="grid">';
    changes.forEach((c) => {
      const pct = pctOf(c);
      h += '<a class="card lc-' + esc(c.lifecycle) + '" href="#/c/' + encodeURIComponent(c.name) + '">' +
        '<div class="row"><h3>' + esc(c.name) + '</h3><span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span></div>" +
        '<p class="metric tnum" style="margin:.6rem 0 0">' + c.done + " / " + c.total + " &middot; " + pct + "%</p>" +
        '<div class="meter"><span style="width:' + pct + '%"></span></div>' +
        '<p class="sub">' + ((c.phases || []).length) + " phases</p>" +
        (c.why ? '<p class="why">' + esc(c.why) + "</p>" : "") +
        "</a>";
    });
    h += "</div>";

    if (!hasDag() && edges.length === 0) {
      h += '<p class="sub" style="margin-top:2rem;color:var(--muted)">No cross-change dependencies defined. ' +
        "Seed them with <code>specutil graph --suggest</code> or edit <code>openspec/specutil.yaml</code>.</p>";
    }

    view.innerHTML = h;
    if (sel) sel.value = "__overview__";
    afterRender();
  }

  function renderBoard() {
    let h = '<h1 tabindex="-1" id="view-title">Board</h1>';
    h += '<p class="metric">Changes grouped by lifecycle.</p>';
    h += '<div class="board">';
    LIFECYCLES.forEach((lc) => {
      const col = changes.filter((c) => c.lifecycle === lc);
      h += '<section class="col"><header><span class="badge ' + lc + '">' + lc + '</span><span class="ct">' + col.length + "</span></header>";
      if (!col.length) {
        h += '<p class="empty-col">None</p>';
      } else {
        col.forEach((c) => {
          const pct = pctOf(c);
          h += '<a class="bcard" href="#/c/' + encodeURIComponent(c.name) + '">' +
            "<h3>" + esc(c.name) + "</h3>" +
            '<div class="meter"><span style="width:' + pct + '%"></span></div>' +
            '<p class="sub tnum">' + c.done + " / " + c.total + " &middot; " + ((c.phases || []).length) + " phases</p>" +
            "</a>";
        });
      }
      h += "</section>";
    });
    h += "</div>";
    view.innerHTML = h;
    if (sel) sel.value = "__board__";
    afterRender();
  }

  function renderGraph() {
    let h = '<h1 tabindex="-1" id="view-title">Graph</h1>';
    if (hasDag()) {
      h += '<p class="metric">Cross-change dependencies — arrows point from a prerequisite to what depends on it. Hover a node to focus its neighbors; click to open it.</p>';
      h += '<div class="dagwrap"></div>';
    } else {
      h += '<p class="empty" style="margin-top:1rem">No cross-change dependencies to graph. ' +
        "Seed them with <code>specutil graph --suggest</code> or edit <code>openspec/specutil.yaml</code>.</p>";
    }
    view.innerHTML = h;
    if (hasDag()) { const slot = view.querySelector(".dagwrap"); if (slot) mountDag(slot); }
    if (sel) sel.value = "__graph__";
    afterRender();
  }

  function kindTag(it) {
    const k = it.kind;
    if (!k || k === "task") return "";
    return '<span class="kind ' + esc(k) + '" title="' + esc(k) + ' step">' + esc(k) + "</span>";
  }

  function renderDetail(name) {
    const c = byName.get(name);
    if (!c) { renderOverview(); return; }
    const pct = pctOf(c);
    const remaining = [];
    (c.phases || []).forEach((p) => (p.items || []).forEach((it) => { if (!it.done) remaining.push(it); }));
    const deps = dependsOn(name), blks = blocks(name);

    let h = "";
    if (!single) h += '<a class="back" href="#/">&larr; All workstreams</a>';
    h += '<div class="doc">';
    h += '<h1 tabindex="-1" id="view-title">' + esc(c.name) + "</h1>";
    h += '<p><span class="badge ' + esc(c.lifecycle) + '">' + esc(c.lifecycle) + "</span> " +
         '<span class="metric tnum">' + c.done + " / " + c.total + " &middot; " + pct + "%</span></p>";

    // Two-column: checklist + narrative on the left, relationships/progress rail
    // on the right. Collapses to one column on narrow viewports (CSS).
    h += '<div class="doclayout"><div class="main">';

    h += '<p class="eyebrow">Remaining</p>';
    if (remaining.length === 0) {
      h += '<p class="alldone">&#10003; All ' + c.total + " tasks complete</p>";
    } else {
      h += '<div class="remaining"><ul class="tasks">';
      remaining.forEach((it) => {
        h += '<li><span class="key">' + esc(it.key) + "</span>" + kindTag(it) + '<span class="txt">' + esc(it.text) + "</span></li>";
      });
      h += "</ul></div>";
    }

    if (c.why) { h += '<p class="eyebrow">Why</p>' + md(c.why); }
    if (c.whatChanges) { h += '<p class="eyebrow">What changes</p>' + md(c.whatChanges); }

    h += '<p class="eyebrow">Tasks by phase</p>';
    (c.phases || []).forEach((p) => {
      const items = p.items || [];
      const d = items.filter((i) => i.done).length;
      h += '<div class="phase-h"><h2>' + esc(p.number) + ". " + esc(p.name) + '</h2><span class="ct tnum">' + d + "/" + items.length + "</span></div>";
      h += '<ul class="tasks">';
      items.forEach((it) => {
        h += '<li class="' + (it.done ? "done" : "") + '">' +
          '<span class="glyph ' + (it.done ? "done" : "todo") + '" aria-hidden="true">' + (it.done ? "&#10003;" : "&#9744;") + "</span>" +
          '<span class="sr-only">' + (it.done ? "Completed: " : "To do: ") + "</span>" +
          '<span class="key">' + esc(it.key) + "</span>" + kindTag(it) +
          '<span class="txt">' + esc(it.text) + "</span></li>";
      });
      h += "</ul>";
    });
    h += "</div>"; // .main

    // ---- relationships + progress rail ----
    h += '<aside class="rail">';
    h += '<div class="panel">';
    h += '<p class="eyebrow">Progress</p>';
    h += '<p class="metric tnum">' + c.done + " / " + c.total + " &middot; " + pct + "%</p>";
    h += '<div class="meter" role="img" aria-label="' + pct + ' percent of tasks complete"><span style="width:' + pct + '%"></span></div>';
    if ((c.phases || []).length) {
      h += '<div class="chartwrap" style="height:' + (c.phases.length * 30 + 12) + 'px">' +
           '<canvas id="phasechart" role="img" aria-label="' + esc(phaseChartLabel(c)) + '"></canvas></div>';
      h += '<ul class="sr-only">' + c.phases.map((p) => {
        const d = p.items.filter((i) => i.done).length;
        return "<li>Phase " + esc(p.number) + " " + esc(p.name) + ": " + d + " of " + p.items.length + " complete</li>";
      }).join("") + "</ul>";
    }
    h += "</div>"; // .panel
    h += '<div class="panel">';
    h += '<p class="eyebrow">Depends on</p>';
    h += deps.length ? '<div class="chips">' + deps.map(chipLink).join("") + "</div>" : '<p class="none">Nothing — ready to start.</p>';
    h += '<p class="eyebrow">Blocks</p>';
    h += blks.length ? '<div class="chips">' + blks.map(chipLink).join("") + "</div>" : '<p class="none">Nothing downstream.</p>';
    h += "</div>"; // .panel
    h += "</aside>";

    h += "</div>"; // .doclayout
    h += "</div>"; // .doc

    view.innerHTML = h;
    if (sel) sel.value = single ? "__overview__" : name;
    afterRender();
    if ((c.phases || []).length) initPhaseChart(c);
  }

  // ---- routing (hash is the single source of truth; works on file://) -------
  let currentRoute = "/";
  function route() {
    destroyChart();
    if (changes.length === 0) { currentRoute = "/"; renderEmpty(); return; }
    if (single) { currentRoute = "/c"; renderDetail(changes[0].name); return; }
    const h = location.hash.replace(/^#/, "");
    const m = h.match(/^\/c\/(.+)$/);
    if (m) {
      const name = decodeURIComponent(m[1]);
      if (byName.has(name)) { currentRoute = "/c/" + name; renderDetail(name); return; }
    }
    if (h === "/board") { currentRoute = "/board"; renderBoard(); return; }
    if (h === "/graph") { currentRoute = "/graph"; renderGraph(); return; }
    currentRoute = "/"; renderOverview();
  }

  // ---- app bar: view tabs, theme toggle, jump-to select ---------------------
  const right = document.getElementById("appbar-right");

  function syncTabs() {
    document.querySelectorAll(".tabs a").forEach((a) => {
      const r = a.getAttribute("data-route");
      const on = (r === "/" && (currentRoute === "/" )) ||
                 (r === "/board" && currentRoute === "/board") ||
                 (r === "/graph" && currentRoute === "/graph");
      a.classList.toggle("on", !!on);
    });
  }

  if (multi) {
    const tabs = document.createElement("nav");
    tabs.className = "tabs";
    [["/", "Overview"], ["/board", "Board"], ["/graph", "Graph"]].forEach(([r, label]) => {
      const a = document.createElement("a");
      a.href = "#" + r; a.textContent = label; a.setAttribute("data-route", r);
      tabs.appendChild(a);
    });
    right.appendChild(tabs);
  }

  // Theme toggle: cycles Auto -> Light -> Dark. Auto removes data-theme so the
  // page follows prefers-color-scheme; Light/Dark force it and persist.
  const toggle = document.createElement("button");
  toggle.className = "toggle"; toggle.type = "button";
  toggle.setAttribute("aria-label", "Toggle color theme");
  function currentMode() {
    try { return localStorage.getItem("specutil-theme") || "auto"; } catch (e) { return "auto"; }
  }
  function applyMode(mode) {
    if (mode === "auto") document.documentElement.removeAttribute("data-theme");
    else document.documentElement.setAttribute("data-theme", mode);
    try { localStorage.setItem("specutil-theme", mode); } catch (e) {}
    const glyph = mode === "light" ? "&#9728;" : mode === "dark" ? "&#9789;" : "&#9681;";
    const label = mode.charAt(0).toUpperCase() + mode.slice(1);
    toggle.innerHTML = '<span aria-hidden="true">' + glyph + "</span> " + label;
    // Re-theme the chart (its colors were baked from CSS vars at init).
    if (window.__chart && window.__chartChange) {
      const c = byName.get(window.__chartChange);
      destroyChart();
      if (c) initPhaseChart(c);
    }
  }
  toggle.addEventListener("click", () => {
    const order = ["auto", "light", "dark"];
    applyMode(order[(order.indexOf(currentMode()) + 1) % order.length]);
  });
  applyMode(currentMode());
  right.appendChild(toggle);

  // System theme changes while in Auto must re-theme the chart too.
  if (window.matchMedia) {
    const mq = window.matchMedia("(prefers-color-scheme: dark)");
    const onSys = () => { if (currentMode() === "auto" && window.__chart && window.__chartChange) {
      const c = byName.get(window.__chartChange); destroyChart(); if (c) initPhaseChart(c);
    } };
    if (mq.addEventListener) mq.addEventListener("change", onSys); else if (mq.addListener) mq.addListener(onSys);
  }

  if (multi) {
    sel = document.createElement("select");
    sel.setAttribute("aria-label", "Jump to a workstream");
    const o0 = document.createElement("option");
    o0.value = "__overview__"; o0.textContent = "Overview";
    sel.appendChild(o0);
    changes.forEach((c) => { const o = document.createElement("option"); o.value = c.name; o.textContent = c.name; sel.appendChild(o); });
    sel.addEventListener("change", () => {
      const v = sel.value;
      location.hash = v === "__overview__" ? "#/" : v === "__board__" ? "#/board" : v === "__graph__" ? "#/graph" : "#/c/" + encodeURIComponent(v);
    });
    right.appendChild(sel);
  }

  // ---- diagnostics banner ---------------------------------------------------
  if (diags.length) {
    const b = document.getElementById("diag-banner");
    const kinds = Array.from(new Set(diags.map((d) => d.kind))).join(", ");
    b.innerHTML = "<b>Manifest problems (" + esc(kinds) + "):</b><ul>" +
      diags.map((d) => "<li>" + esc(d.msg) + "</li>").join("") + "</ul>";
    b.hidden = false;
  }

  if (window.__cdnFail && window.__cdnFail.length) { document.getElementById("offline-note").hidden = false; }

  window.addEventListener("hashchange", route);
  route();
})();
</script>
</body>
</html>
